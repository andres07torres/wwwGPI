{% block page_scripts %}
<script>
(function() {
	function initEscalationModule() {
		const searchInput = document.getElementById('escalationSearchInput');
		const filterLevel = document.getElementById('filterEscalationLevel');
		const filterAlert = document.getElementById('filterAlertType');
		const filterPriority = document.getElementById('filterPriority');
		const filterType = document.getElementById('filterType');
		const tableCounter = document.getElementById('escalationTableCounter');
		const rows = document.querySelectorAll('.escalation-row');

		function filterTable() {
			const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
			const levelVal = filterLevel ? filterLevel.value : '';
			const alertVal = filterAlert ? filterAlert.value : '';
			const priorityVal = filterPriority ? filterPriority.value : '';
			const typeVal = filterType ? filterType.value : '';

			let visibleCount = 0;

			rows.forEach(function(row) {
				const rowSearch = (row.dataset.search || '').toLowerCase();
				const rowLevel = row.dataset.level || '';
				const rowAlert = row.dataset.alert || '';
				const rowPriority = row.dataset.priority || '';
				const rowType = row.dataset.type || '';

				const matchesQuery = !query || rowSearch.indexOf(query) !== -1;
				const matchesLevel = !levelVal || rowLevel.indexOf(levelVal) !== -1;
				const matchesAlert = !alertVal || rowAlert === alertVal;
				const matchesPriority = !priorityVal || rowPriority === priorityVal;
				const matchesType = !typeVal || rowType === typeVal;

				if (matchesQuery && matchesLevel && matchesAlert && matchesPriority && matchesType) {
					row.classList.remove('d-none');
					visibleCount++;
				} else {
					row.classList.add('d-none');
				}
			});

			if (tableCounter) {
				tableCounter.innerHTML = 'Mostrando <strong>' + visibleCount + '</strong> de <strong>' + rows.length + '</strong> registros de alertas';
			}
		}

		if (searchInput) searchInput.addEventListener('input', filterTable);
		if (filterLevel) filterLevel.addEventListener('change', filterTable);
		if (filterAlert) filterAlert.addEventListener('change', filterTable);
		if (filterPriority) filterPriority.addEventListener('change', filterTable);
		if (filterType) filterType.addEventListener('change', filterTable);

		// Precarga del Modal de Escalamiento al presionar "Escalar"
		const formEscalate = document.getElementById('formEscalateTicket');
		const codeEl = document.getElementById('modalEscalateCode');
		const titleEl = document.getElementById('modalEscalateSummaryTitle');
		const priorityBadge = document.getElementById('modalEscalatePriorityBadge');
		const currentLevelText = document.getElementById('modalEscalateCurrentLevelText');
		const selectTargetLevel = document.getElementById('selectEscalationLevel');
		const selectTargetUser = document.getElementById('selectTargetUser');

		document.querySelectorAll('.btn-open-escalate').forEach(function(btn) {
			btn.addEventListener('click', function() {
				const ticketId = this.dataset.ticketId || '';
				const ticketCode = this.dataset.ticketCode || '';
				const ticketTitle = this.dataset.ticketTitle || '';
				const ticketPriority = this.dataset.ticketPriority || '';
				const ticketPriorityColor = this.dataset.ticketPriorityColor || '#14212B';
				const assigneeId = this.dataset.ticketAssigneeId || '';
				const currentLevel = this.dataset.currentLevel || '1';
				const targetLevel = this.dataset.targetLevel || '2';

				if (formEscalate) {
					formEscalate.action = '/sla/escalations/' + encodeURIComponent(ticketId) + '/escalate';
				}
				if (codeEl) codeEl.textContent = ticketCode;
				if (titleEl) titleEl.textContent = ticketTitle;
				if (priorityBadge) {
					priorityBadge.textContent = ticketPriority;
					priorityBadge.style.color = ticketPriorityColor;
					priorityBadge.style.backgroundColor = ticketPriorityColor + '18';
					priorityBadge.style.borderColor = ticketPriorityColor + '35';
				}
				if (currentLevelText) {
					currentLevelText.textContent = 'Nivel Actual: Nivel ' + currentLevel;
				}
				if (selectTargetLevel) {
					selectTargetLevel.value = targetLevel;
				}
				if (selectTargetUser && assigneeId) {
					selectTargetUser.value = assigneeId;
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initEscalationModule);
	} else {
		initEscalationModule();
	}
	document.addEventListener('turbo:load', initEscalationModule);
})();
</script>
{% endblock %}
{% endblock %}
