<script>
(function() {
	function initOrganizationsModule() {
		const searchInput = document.getElementById('organizationSearchInput');
		const statusSelect = document.getElementById('organizationStatusFilter');
		const cardCols = Array.from(document.querySelectorAll('.organization-card-col'));
		const tableRows = Array.from(document.querySelectorAll('.organization-table-row'));
		const emptyState = document.getElementById('organizationsEmptyState');
		const cardsContainer = document.getElementById('organizationsCardsContainer');
		const tableContainer = document.getElementById('organizationsTableContainer');

		const csrfMapEl = document.getElementById('csrfTokensOrgData');
		let csrfMap = {};
		if (csrfMapEl) {
			try { csrfMap = JSON.parse(csrfMapEl.textContent); } catch (e) { csrfMap = {}; }
		}

		let activeStatus = '';

		// 1. Filtrado en tiempo real (Búsqueda y Estado)
		function applyOrganizationFilters() {
			const q = (searchInput ? searchInput.value : '').trim().toLowerCase();
			const selectedStatus = activeStatus || (statusSelect ? statusSelect.value : '');

			let visibleCount = 0;

			// Filtrar Tarjetas
			cardCols.forEach(col => {
				const name = col.dataset.name || '';
				const domain = col.dataset.domain || '';
				const status = col.dataset.status || '';

				const matchesQ = !q || name.includes(q) || domain.includes(q);
				const matchesStatus = !selectedStatus || status === selectedStatus;

				if (matchesQ && matchesStatus) {
					col.style.display = '';
					visibleCount++;
				} else {
					col.style.display = 'none';
				}
			});

			// Filtrar Filas de Tabla
			tableRows.forEach(row => {
				const name = row.dataset.name || '';
				const domain = row.dataset.domain || '';
				const status = row.dataset.status || '';

				const matchesQ = !q || name.includes(q) || domain.includes(q);
				const matchesStatus = !selectedStatus || status === selectedStatus;

				row.style.display = (matchesQ && matchesStatus) ? '' : 'none';
			});

			if (emptyState) {
				emptyState.style.display = (visibleCount === 0) ? '' : 'none';
			}
		}

		if (searchInput) searchInput.addEventListener('input', applyOrganizationFilters);
		if (statusSelect) {
			statusSelect.addEventListener('change', function() {
				activeStatus = this.value;
				updateStatusPillsActiveState(activeStatus);
				applyOrganizationFilters();
			});
		}

		// Pills de Estado
		document.querySelectorAll('.status-pill').forEach(pill => {
			pill.addEventListener('click', function() {
				activeStatus = this.dataset.status || '';
				if (statusSelect) statusSelect.value = activeStatus;
				updateStatusPillsActiveState(activeStatus);
				applyOrganizationFilters();
			});
		});

		function updateStatusPillsActiveState(status) {
			document.querySelectorAll('.status-pill').forEach(p => {
				const isMatch = (p.dataset.status || '') === status;
				p.classList.toggle('active', isMatch);
				p.classList.toggle('btn-panel-action', isMatch);
				p.classList.toggle('btn-outline-secondary', !isMatch);
			});
		}

		// 2. Alternador de Vistas (Tarjetas vs Tabla)
		const btnViewCards = document.getElementById('btnViewCards');
		const btnViewTable = document.getElementById('btnViewTable');

		function setView(view) {
			if (view === 'table') {
				cardsContainer?.classList.add('d-none');
				tableContainer?.classList.remove('d-none');
				btnViewCards?.classList.remove('active');
				btnViewTable?.classList.add('active');
				try { localStorage.setItem('gpi_organization_view', 'table'); } catch(e) {}
			} else {
				cardsContainer?.classList.remove('d-none');
				tableContainer?.classList.add('d-none');
				btnViewCards?.classList.add('active');
				btnViewTable?.classList.remove('active');
				try { localStorage.setItem('gpi_organization_view', 'cards'); } catch(e) {}
			}
		}

		btnViewCards?.addEventListener('click', () => setView('cards'));
		btnViewTable?.addEventListener('click', () => setView('table'));

		try {
			const savedView = localStorage.getItem('gpi_organization_view');
			if (savedView === 'table') setView('table');
		} catch(e) {}

		// 3. Modales Dinámicos
		const modalDetailEl = document.getElementById('modalDetailOrganization');
		const modalEditEl = document.getElementById('modalEditOrganization');
		const modalDeleteEl = document.getElementById('modalDeleteOrganization');

		// Modal 2: Detalle de la Organización
		if (modalDetailEl && !modalDetailEl.dataset.listenerAttached) {
			modalDetailEl.dataset.listenerAttached = 'true';
			modalDetailEl.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-open-detail') || event.relatedTarget) : null;
				if (!btn || !btn.dataset.id) return;

				const id = btn.dataset.id;
				document.getElementById('detailOrgName').textContent = 'Cargando organización...';
				document.getElementById('detailOrgDomain').textContent = '...';
				document.getElementById('detailOrgUsersList').innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Consultando datos...';

				fetch(`/admin/organizations/${id}/detail`)
					.then(r => r.json())
					.then(d => {
						if (!d.success) return;
						const org = d.organization;
						document.getElementById('detailOrgName').textContent = org.name;
						document.getElementById('detailOrgDomain').textContent = org.domain;
						document.getElementById('detailOrgStatus').textContent = org.status ? 'Activo' : 'Inactivo';
						document.getElementById('detailOrgCreatedAt').textContent = org.createdAt;
						document.getElementById('detailOrgUsersCount').textContent = org.usersCount;

						const usersListEl = document.getElementById('detailOrgUsersList');
						if (org.users && org.users.length > 0) {
							let html = '<ul class="list-group list-group-flush">';
							org.users.forEach(u => {
								html += `
									<li class="list-group-item px-0 py-1.5 d-flex align-items-center justify-content-between">
										<div>
											<strong class="text-dark">${u.name}</strong>
											<span class="text-muted d-block" style="font-size: 11px;">${u.email}</span>
										</div>
										<span class="badge ${u.isActive ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'} border">
											${u.isActive ? 'Activo' : 'Inactivo'}
										</span>
									</li>
								`;
							});
							html += '</ul>';
							usersListEl.innerHTML = html;
						} else {
							usersListEl.innerHTML = '<span class="text-muted fst-italic">No hay usuarios vinculados a esta organización.</span>';
						}
					})
					.catch(err => {
						console.error('Error al consultar organización:', err);
						document.getElementById('detailOrgUsersList').textContent = 'Error al cargar los datos.';
					});
			});
		}

		// Modal 3: Editar Organización
		const formEdit = document.getElementById('formEditOrganization');
		if (modalEditEl && !modalEditEl.dataset.listenerAttached) {
			modalEditEl.dataset.listenerAttached = 'true';
			modalEditEl.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-open-edit') || event.relatedTarget) : null;
				if (!btn || !btn.dataset.id) return;

				const id = btn.dataset.id;
				if (formEdit) formEdit.action = `/admin/organizations/${id}/edit`;
				document.getElementById('edit_org_csrf').value = csrfMap[id]?.edit || '';

				fetch(`/admin/organizations/${id}/detail`)
					.then(r => r.json())
					.then(d => {
						if (!d.success) return;
						const org = d.organization;
						document.getElementById('edit_org_name').value = org.name;
						document.getElementById('edit_org_domain').value = org.domain;
						document.getElementById('edit_org_status').value = org.status ? '1' : '0';
					})
					.catch(err => console.error('Error al cargar datos:', err));
			});
		}

		// Modal 4: Eliminar Organización
		const formDelete = document.getElementById('formDeleteOrganization');
		if (modalDeleteEl && !modalDeleteEl.dataset.listenerAttached) {
			modalDeleteEl.dataset.listenerAttached = 'true';
			modalDeleteEl.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-open-delete') || event.relatedTarget) : null;
				if (!btn) return;

				const id = btn.dataset.id;
				const name = btn.dataset.name;
				const usersCount = parseInt(btn.dataset.usersCount || '0', 10);

				if (formDelete) formDelete.action = `/admin/organizations/${id}/delete`;
				document.getElementById('delete_org_csrf').value = csrfMap[id]?.delete || '';
				document.getElementById('deleteOrgTitle').textContent = name || '-';

				const warningEl = document.getElementById('deleteOrgWarning');
				if (usersCount > 0) {
					warningEl.className = 'alert alert-danger small mb-0 py-1.5 text-start';
					warningEl.textContent = `Atención: Esta organización cuenta con ${usersCount} usuario(s) vinculado(s). Debe reasignar o eliminar los usuarios antes de poder removerla.`;
				} else {
					warningEl.className = 'alert alert-warning small mb-0 py-1.5 text-start';
					warningEl.textContent = 'Esta acción removerá permanentemente la organización si no cuenta con usuarios ni dependencias.';
				}
			});
		}

		// Blindaje Global Anti-Backdrop Huérfano
		if (!document.body.dataset.organizationModalBackdropCleanupAttached) {
			document.body.dataset.organizationModalBackdropCleanupAttached = 'true';
			document.addEventListener('hidden.bs.modal', function () {
				setTimeout(function () {
					if (!document.querySelector('.modal.show')) {
						document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
						document.body.classList.remove('modal-open');
						document.body.style.removeProperty('overflow');
						document.body.style.removeProperty('padding-right');
					}
				}, 50);
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initOrganizationsModule);
	} else {
