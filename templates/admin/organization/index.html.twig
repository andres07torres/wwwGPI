{% extends 'layout.html.twig' %}

{% block title %}GPI · Organizaciones{% endblock %}

{% block content %}
<div class="user-module-wrapper">
	<!-- Encabezado del Módulo y Breadcrumbs -->
	<div class="mb-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-2 small">
				<li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Inicio</a></li>
				<li class="breadcrumb-item text-muted">Administración del Sistema</li>
				<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Organizaciones</li>
			</ol>
		</nav>
		<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
			<div class="pe-md-3">
				<h1 class="h3 fw-bold text-dark mb-1">Organizaciones</h1>
				<p class="text-muted mb-0">
					Gestión centralizada de organizaciones, tenants multicliente, dominios corporativos y estado operativo.
				</p>
			</div>
			<div class="d-flex align-items-center justify-content-end gap-2 flex-shrink-0 flex-wrap">
				<button type="button" class="btn btn-panel-action shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateOrganization">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="5" x2="12" y2="19"/>
						<line x1="5" y1="12" x2="19" y2="12"/>
					</svg>
					<span>Nueva Organización</span>
				</button>
			</div>
		</div>
	</div>

	<!-- Cartas de Indicadores Clave (KPIs) -->
	<div class="row g-3 mb-4">
		<!-- KPI 1: Total Organizaciones -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Total de Organizaciones registradas">Organizaciones</span>
						<div class="kpi-card-value text-truncate">{{ stats.totalTenants }}</div>
					</div>
					<div class="kpi-icon-panel" title="Total Tenants">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 21h18"/>
							<path d="M9 8h1"/>
							<path d="M9 12h1"/>
							<path d="M9 16h1"/>
							<path d="M14 8h1"/>
							<path d="M14 12h1"/>
							<path d="M14 16h1"/>
							<path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 2: Activas -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Organizaciones con servicio activo">Activas</span>
						<div class="kpi-card-value text-truncate text-success">{{ stats.activeTenants }}</div>
					</div>
					<div class="kpi-icon-panel" title="Organizaciones activas">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
							<polyline points="22 4 12 14.01 9 11.01"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 3: Inactivas -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Organizaciones suspendidas o inactivas">Inactivas</span>
						<div class="kpi-card-value text-truncate text-secondary">{{ stats.inactiveTenants }}</div>
					</div>
					<div class="kpi-icon-panel" title="Organizaciones suspendidas">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 4: Usuarios Vinculados -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Total de usuarios en todas las organizaciones">Usuarios</span>
						<div class="kpi-card-value text-truncate" style="color: var(--panel, #14212B);">{{ stats.totalUsersCount }}</div>
					</div>
					<div class="kpi-icon-panel" title="Usuarios totales">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
						</svg>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Barra de Búsqueda y Filtros -->
	<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white p-3">
		<div class="row g-3 align-items-center justify-content-between">
			<!-- Buscador en tiempo real -->
			<div class="col-12 col-md-6 col-lg-5">
				<div class="input-group">
					<span class="input-group-text bg-white border-end-0 text-muted">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="11" cy="11" r="8"/>
							<line x1="21" y1="21" x2="16.65" y2="16.65"/>
						</svg>
					</span>
					<input type="text" id="organizationSearchInput" class="form-control border-start-0 ps-0" placeholder="Buscar por organización, dominio corporativo...">
				</div>
			</div>

			<!-- Selector de Estado -->
			<div class="col-12 col-md-4 col-lg-4">
				<select id="organizationStatusFilter" class="form-select">
					<option value="">Todos los Estados ({{ tenants|length }})</option>
					<option value="active">Activas ({{ stats.activeTenants }})</option>
					<option value="inactive">Inactivas ({{ stats.inactiveTenants }})</option>
				</select>
			</div>

			<!-- Alternador de Vistas (Tarjetas vs Tabla) -->
			<div class="col-12 col-md-2 col-lg-3 text-md-end">
				<div class="btn-group btn-group-sm" role="group" aria-label="Cambiar vista">
					<button type="button" class="btn btn-outline-secondary active" id="btnViewCards" title="Vista Tarjetas">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="3" width="7" height="7"/>
							<rect x="14" y="3" width="7" height="7"/>
							<rect x="14" y="14" width="7" height="7"/>
							<rect x="3" y="14" width="7" height="7"/>
						</svg>
						<span class="d-none d-lg-inline ms-1">Tarjetas</span>
					</button>
					<button type="button" class="btn btn-outline-secondary" id="btnViewTable" title="Vista Tabla">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="8" y1="6" x2="21" y2="6"/>
							<line x1="8" y1="12" x2="21" y2="12"/>
							<line x1="8" y1="18" x2="21" y2="18"/>
							<line x1="3" y1="6" x2="3.01" y2="6"/>
							<line x1="3" y1="12" x2="3.01" y2="12"/>
							<line x1="3" y1="18" x2="3.01" y2="18"/>
						</svg>
						<span class="d-none d-lg-inline ms-1">Tabla</span>
					</button>
				</div>
			</div>
		</div>

		<!-- Pills de Estados Rápidos -->
		<div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top" id="statusPillsContainer">
			<button type="button" class="btn btn-xs status-pill active btn-panel-action" data-status="">
				Todas las Organizaciones ({{ tenants|length }})
			</button>
			<button type="button" class="btn btn-xs status-pill btn-outline-secondary" data-status="active">
				Activas ({{ stats.activeTenants }})
			</button>
			<button type="button" class="btn btn-xs status-pill btn-outline-secondary" data-status="inactive">
				Inactivas ({{ stats.inactiveTenants }})
			</button>
		</div>
	</div>

	<!-- =========================================================================
	     VISTA 1: TARJETAS DE ORGANIZACIONES (CARDS GRID)
	     ========================================================================= -->
	<div id="organizationsCardsContainer" class="row g-3 mb-4">
		{% for t in tenants %}
			<div class="col-12 col-md-6 col-xl-4 organization-card-col" 
				 data-id="{{ t.id }}"
				 data-name="{{ t.name|lower }}" 
				 data-domain="{{ t.domain|lower }}" 
				 data-status="{{ t.status ? 'active' : 'inactive' }}">
				<div class="card h-100 border-0 shadow-sm rounded-3 bg-white p-3 d-flex flex-column justify-content-between organization-card-item">
					<div>
						<!-- Cabecera de la tarjeta con dominio y estado en texto plano -->
						<div class="d-flex align-items-center justify-content-between mb-2">
							<span class="guide-category-text font-monospace text-truncate" style="max-width: 200px;" title="Dominio corporativo">
								{{ t.domain }}
							</span>
							<span class="fw-semibold small" style="color: var(--panel, #14212B);">
								{{ t.status ? 'Activa' : 'Inactiva' }}
							</span>
						</div>

						<!-- Nombre de la Organización -->
						<h5 class="card-title fw-bold text-dark h6 mb-2 lh-base d-flex align-items-center gap-1.5 flex-wrap">
							<a href="javascript:void(0)" class="text-decoration-none text-dark hover-primary btn-open-detail" data-bs-toggle="modal" data-bs-target="#modalDetailOrganization" data-id="{{ t.id }}">
								{{ t.name }}
							</a>
							{% if currentTenantId and currentTenantId == t.id.toRfc4122 %}
								<span class="text-muted fw-normal" style="font-size: 11px;">(Actual)</span>
							{% endif %}
						</h5>

						<!-- Indicadores y métricas de la Organización -->
						<div class="d-flex align-items-center gap-3 py-2 my-1 border-top border-bottom border-light small text-muted">
							<div class="d-flex align-items-center gap-1.5" title="Usuarios vinculados a esta organización">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
									<circle cx="9" cy="7" r="4"/>
								</svg>
								<span class="text-dark fw-semibold">{{ t.users|length }}</span>
								<span>usuarios</span>
							</div>
							<div class="d-flex align-items-center gap-1.5" title="Roles de acceso asignados">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
								</svg>
								<span class="text-dark fw-semibold">{{ t.roles|length }}</span>
								<span>roles</span>
							</div>
						</div>
					</div>

					<!-- Pie de la Tarjeta con Fecha y Acciones -->
					<div class="pt-3 border-top d-flex align-items-center justify-content-between gap-2 mt-auto">
						<div class="text-muted small text-truncate" style="max-width: 130px;">
							<span class="d-block text-muted" style="font-size: 11px;">Registro: {{ t.createdAt|date('d/m/Y') }}</span>
						</div>
						<div class="d-inline-flex align-items-center gap-1">
							<!-- Botón Detalle -->
							<button type="button" class="btn btn-sm btn-outline-panel btn-icon-action btn-open-detail" data-bs-toggle="modal" data-bs-target="#modalDetailOrganization" data-id="{{ t.id }}" title="Ver detalles">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
									<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
								</svg>
							</button>

							<!-- Botón Editar -->
							<button type="button" class="btn btn-sm btn-outline-panel btn-icon-action btn-open-edit" data-bs-toggle="modal" data-bs-target="#modalEditOrganization" data-id="{{ t.id }}" title="Editar organización">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M12 20h9"/>
									<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
								</svg>
							</button>

							<!-- Botón Alternar Estado (Activar/Desactivar) -->
							<form method="POST" action="{{ path('app_admin_organization_toggle_status', {id: t.id}) }}" class="d-inline" data-turbo="false">
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_organization_' ~ t.id) }}">
								<button type="submit" class="btn btn-sm btn-outline-panel btn-icon-action" title="{{ t.status ? 'Desactivar organización' : 'Activar organización' }}">
									{% if t.status %}
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="6" y="4" width="4" height="16"/>
											<rect x="14" y="4" width="4" height="16"/>
										</svg>
									{% else %}
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<polygon points="5 3 19 12 5 21 5 3"/>
										</svg>
									{% endif %}
								</button>
							</form>

							<!-- Botón Eliminar -->
							<button type="button" class="btn btn-sm btn-outline-danger btn-icon-action btn-open-delete" data-bs-toggle="modal" data-bs-target="#modalDeleteOrganization" data-id="{{ t.id }}" data-name="{{ t.name|e('html_attr') }}" data-users-count="{{ t.users|length }}" title="Eliminar organización">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="3 6 5 6 21 6"/>
									<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
								</svg>
							</button>
						</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	<!-- =========================================================================
	     VISTA 2: TABLA DE ORGANIZACIONES (TABLE LIST)
	     ========================================================================= -->
	<div id="organizationsTableContainer" class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4 d-none">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0" id="organizationsTable">
				<thead class="bg-light border-bottom">
					<tr class="small text-secondary text-uppercase">
						<th class="ps-3 py-3" style="width: 32%;">Organización</th>
						<th class="py-3">Dominio Corporativo</th>
						<th class="py-3 text-center">Usuarios</th>
						<th class="py-3 text-center">Roles</th>
						<th class="py-3">Estado</th>
						<th class="py-3">Fecha Registro</th>
						<th class="pe-3 py-3 text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
					{% for t in tenants %}
						<tr class="organization-table-row" 
							data-id="{{ t.id }}"
							data-name="{{ t.name|lower }}" 
							data-domain="{{ t.domain|lower }}" 
							data-status="{{ t.status ? 'active' : 'inactive' }}">
							<td class="ps-3 py-3">
								<a href="javascript:void(0)" class="fw-semibold text-dark text-decoration-none btn-open-detail hover-primary" data-bs-toggle="modal" data-bs-target="#modalDetailOrganization" data-id="{{ t.id }}">
									{{ t.name }}
								</a>
								{% if currentTenantId and currentTenantId == t.id.toRfc4122 %}
									<span class="text-muted ms-1 small" style="font-size: 11px;">(Actual)</span>
								{% endif %}
							</td>
							<td class="py-3 font-monospace small">
								<span class="guide-category-text">{{ t.domain }}</span>
							</td>
							<td class="py-3 text-center">
								<span class="badge bg-light text-dark border fw-semibold">
									{{ t.users|length }}
								</span>
							</td>
							<td class="py-3 text-center">
								<span class="badge bg-light text-secondary border fw-medium">
									{{ t.roles|length }}
								</span>
							</td>
							<td class="py-3">
								<span class="fw-semibold small" style="color: var(--panel, #14212B);">
									{{ t.status ? 'Activa' : 'Inactiva' }}
								</span>
							</td>
							<td class="py-3 text-secondary small">
								{{ t.createdAt|date('d/m/Y') }}
							</td>
							<td class="pe-3 py-3 text-end">
								<div class="d-inline-flex align-items-center gap-1">
									<!-- Detalle -->
									<button type="button" class="btn btn-sm btn-outline-panel btn-icon-action btn-open-detail" data-bs-toggle="modal" data-bs-target="#modalDetailOrganization" data-id="{{ t.id }}" title="Ver detalles">
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
											<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
										</svg>
									</button>

									<!-- Editar -->
									<button type="button" class="btn btn-sm btn-outline-panel btn-icon-action btn-open-edit" data-bs-toggle="modal" data-bs-target="#modalEditOrganization" data-id="{{ t.id }}" title="Editar organización">
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M12 20h9"/>
											<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
										</svg>
									</button>

									<!-- Alternar Estado -->
									<form method="POST" action="{{ path('app_admin_organization_toggle_status', {id: t.id}) }}" class="d-inline" data-turbo="false">
										<input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_organization_' ~ t.id) }}">
										<button type="submit" class="btn btn-sm btn-outline-panel btn-icon-action" title="{{ t.status ? 'Desactivar organización' : 'Activar organización' }}">
											{% if t.status %}
												<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<rect x="6" y="4" width="4" height="16"/>
													<rect x="14" y="4" width="4" height="16"/>
												</svg>
											{% else %}
												<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<polygon points="5 3 19 12 5 21 5 3"/>
												</svg>
											{% endif %}
										</button>
									</form>

									<!-- Eliminar -->
									<button type="button" class="btn btn-sm btn-outline-danger btn-icon-action btn-open-delete" data-bs-toggle="modal" data-bs-target="#modalDeleteOrganization" data-id="{{ t.id }}" data-name="{{ t.name|e('html_attr') }}" data-users-count="{{ t.users|length }}" title="Eliminar organización">
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<polyline points="3 6 5 6 21 6"/>
											<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
										</svg>
									</button>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	<!-- Estado vacío cuando no hay resultados de búsqueda -->
	<div id="organizationsEmptyState" class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white" style="display: none;">
		<div class="avatar-circle-lg bg-light text-muted mx-auto mb-3">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="11" cy="11" r="8"/>
				<line x1="21" y1="21" x2="16.65" y2="16.65"/>
			</svg>
		</div>
		<h5 class="fw-bold text-dark mb-1">No se encontraron organizaciones</h5>
		<p class="text-muted small mb-0">Intenta con otros términos o cambia el filtro de estado.</p>
	</div>
</div>

<!-- =========================================================================
     MODAL 1: REGISTRAR NUEVA ORGANIZACIÓN
     ========================================================================= -->
<div class="modal fade" id="modalCreateOrganization" tabindex="-1" aria-labelledby="modalCreateOrganizationLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
		<div class="modal-content border-0 shadow">
			<form method="POST" action="{{ path('app_admin_organization_create') }}" data-turbo="false">
