{% extends 'layout.html.twig' %}

{% block title %}GPI · Dashboard Operativo & Analítica{% endblock %}

{% block content %}
<div class="user-module-wrapper">
	<!-- Encabezado del Dashboard con Saludo y Accesos Rápidos -->
	<div class="mb-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-2 small">
				<li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Inicio</a></li>
				<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Dashboard General</li>
			</ol>
		</nav>
		<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
			<div class="pe-md-3">
				<h1 class="h3 fw-bold text-dark mb-1">Panel de Control Operativo</h1>
				<p class="text-muted mb-0">
					Supervisión centralizada del flujo de mesa de ayuda, infraestructura TI y acuerdos de nivel de servicio (SLA).
				</p>
			</div>
			<div class="d-flex align-items-center justify-content-end gap-2 flex-wrap flex-shrink-0">
				<a href="{{ path('app_ticket_index') }}" class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
						<line x1="7" y1="2" x2="7" y2="22"/>
						<line x1="17" y1="2" x2="17" y2="22"/>
						<line x1="2" y1="12" x2="22" y2="12"/>
					</svg>
					<span>Mesa de Ayuda</span>
				</a>
				<a href="{{ path('app_sla_compliance_index') }}" class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12 6 12 12 16 14"/>
					</svg>
					<span>Monitor SLA</span>
				</a>
				<a href="{{ path('app_cmdb_topology_index') }}" class="btn btn-panel-action shadow-sm d-flex align-items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
						<rect x="2" y="2" width="6" height="6" rx="1"/>
						<rect x="16" y="2" width="6" height="6" rx="1"/>
						<rect x="9" y="16" width="6" height="6" rx="1"/>
						<path d="M5 8v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/>
						<line x1="12" y1="13" x2="12" y2="16"/>
					</svg>
					<span>Topología TI</span>
				</a>
			</div>
		</div>
	</div>

	<!-- =========================================================================
	     FILA 1: CUATRO CARTAS EJECUTIVAS (KPIS)
	     ========================================================================= -->
	<div class="row g-3 mb-4">
		<!-- KPI 1: Total Tickets -->
		<div class="col-6 col-lg-3">
			<div class="card border-0 shadow-sm p-3 rounded-3 h-100 bg-white">
				<div class="d-flex align-items-center justify-content-between gap-2 mb-2">
					<div class="min-w-0 flex-grow-1">
						<div class="text-muted small fw-semibold text-uppercase text-truncate" style="letter-spacing: 0.3px; font-size: 11px;">Total Tickets</div>
						<div class="h2 fw-bold text-dark mb-0 mt-1">{{ stats.total_tickets }}</div>
					</div>
					<div class="kpi-icon-panel flex-shrink-0" title="Volumen Total de Tickets">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
							<path d="M13 5v2"/>
							<path d="M13 17v2"/>
							<path d="M13 11v2"/>
						</svg>
					</div>
				</div>
				<div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
					<span><strong>{{ stats.open_tickets }}</strong> activos</span>
					<span><strong>{{ stats.resolved_tickets }}</strong> resueltos</span>
				</div>
			</div>
		</div>

		<!-- KPI 2: Cumplimiento SLA -->
		<div class="col-6 col-lg-3">
			<div class="card border-0 shadow-sm p-3 rounded-3 h-100 bg-white">
				<div class="d-flex align-items-center justify-content-between gap-2 mb-2">
					<div class="min-w-0 flex-grow-1">
						<div class="text-muted small fw-semibold text-uppercase text-truncate" style="letter-spacing: 0.3px; font-size: 11px;">Cumplimiento SLA</div>
						<div class="h2 fw-bold mb-0 mt-1" style="color: {% if stats.compliance_rate >= 80 %}#10b981{% elseif stats.compliance_rate >= 50 %}#d97706{% else %}#ef4444{% endif %};">
							{{ stats.compliance_rate }}%
						</div>
					</div>
					<div class="kpi-icon-panel flex-shrink-0" title="Porcentaje Global de Cumplimiento">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polyline points="12 6 12 12 14 14"/>
						</svg>
					</div>
				</div>
				<div class="d-flex align-items-center justify-content-between pt-2 border-top small">
					<span class="text-success"><strong>{{ stats.on_time_sla }}</strong> a tiempo</span>
					<span class="text-danger"><strong>{{ stats.breached_sla }}</strong> vencidos</span>
				</div>
			</div>
		</div>

		<!-- KPI 3: Activos e Infraestructura -->
		<div class="col-6 col-lg-3">
			<div class="card border-0 shadow-sm p-3 rounded-3 h-100 bg-white">
				<div class="d-flex align-items-center justify-content-between gap-2 mb-2">
					<div class="min-w-0 flex-grow-1">
						<div class="text-muted small fw-semibold text-uppercase text-truncate" style="letter-spacing: 0.3px; font-size: 11px;">Activos TI (CMDB)</div>
						<div class="h2 fw-bold text-dark mb-0 mt-1">{{ stats.total_cis }}</div>
					</div>
					<div class="kpi-icon-panel flex-shrink-0" title="Elementos de Configuración">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
							<rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
							<line x1="6" y1="6" x2="6.01" y2="6"/>
							<line x1="6" y1="18" x2="6.01" y2="18"/>
						</svg>
					</div>
				</div>
				<div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
					<span><strong>{{ stats.physical_cis }}</strong> físicos</span>
					<span><strong>{{ stats.logical_cis }}</strong> lógicos</span>
				</div>
			</div>
		</div>

		<!-- KPI 4: Usuarios & Tenants -->
		<div class="col-6 col-lg-3">
			<div class="card border-0 shadow-sm p-3 rounded-3 h-100 bg-white">
				<div class="d-flex align-items-center justify-content-between gap-2 mb-2">
					<div class="min-w-0 flex-grow-1">
						<div class="text-muted small fw-semibold text-uppercase text-truncate" style="letter-spacing: 0.3px; font-size: 11px;">Usuarios del Sistema</div>
						<div class="h2 fw-bold text-dark mb-0 mt-1">{{ stats.total_users }}</div>
					</div>
					<div class="kpi-icon-panel flex-shrink-0" title="Cuentas Registradas">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
						</svg>
					</div>
				</div>
				<div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
					<span><strong>{{ stats.total_tenants }}</strong> tenants</span>
					<span class="text-success"><span class="d-inline-block rounded-circle bg-success me-1" style="width: 7px; height: 7px;"></span>En línea</span>
				</div>
			</div>
		</div>
	</div>

	<!-- =========================================================================
	     FILA 2: GRÁFICO DE BARRAS (ESTADOS) & GRÁFICO DE PASTEL (SLA)
	     ========================================================================= -->
	<div class="row g-4 mb-4">
		<!-- Gráfico de Barras: Tickets por Estado Operativo -->
		<div class="col-12 col-xl-8">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100">
				<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
					<div>
						<h6 class="fw-bold text-dark mb-0">Flujo Operativo de Tickets</h6>
						<div class="text-muted small" style="font-size: 11px;">Distribución de casos por estado de ciclo de vida</div>
					</div>
					<a href="{{ path('app_ticket_index') }}" class="small text-decoration-none fw-semibold" style="color: var(--panel, #14212B);">Ver Mesa de Ayuda &rarr;</a>
				</div>
				<div class="card-body p-3 p-md-4">
					<div style="height: 290px; position: relative;">
						<canvas id="chartTicketsStatus"></canvas>
					</div>
				</div>
			</div>
		</div>

		<!-- Gráfico de Pastel / Donut: Cumplimiento de Acuerdos SLA -->
		<div class="col-12 col-xl-4">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100">
				<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
					<div>
						<h6 class="fw-bold text-dark mb-0">Cumplimiento de SLA</h6>
						<div class="text-muted small" style="font-size: 11px;">Estado en tiempo real de compromisos</div>
					</div>
					<a href="{{ path('app_sla_compliance_index') }}" class="small text-decoration-none fw-semibold" style="color: var(--panel, #14212B);">Ver Todo &rarr;</a>
				</div>
				<div class="card-body p-3 p-md-4 d-flex flex-column align-items-center justify-content-center">
					<div style="height: 230px; width: 100%; position: relative;">
						<canvas id="chartSlaCompliance"></canvas>
					</div>
					<div class="mt-3 text-center">
						<div class="small fw-semibold text-secondary">Tasa de Efectividad</div>
						<div class="h4 fw-bold mb-0" style="color: var(--panel, #14212B);">{{ stats.compliance_rate }}%</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- =========================================================================
	     FILA 3: GRÁFICO DE BARRAS PRIORIDAD & PASTEL DE ACTIVOS TI
	     ========================================================================= -->
	<div class="row g-4 mb-4">
		<!-- Gráfico de Barras: Severidad y Prioridad -->
		<div class="col-12 col-lg-6">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100">
				<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
					<div>
						<h6 class="fw-bold text-dark mb-0">Volumen por Severidad y Prioridad</h6>
						<div class="text-muted small" style="font-size: 11px;">Clasificación de incidentes para atención urgente</div>
					</div>
					<span class="small text-muted">Incidentes y Solicitudes</span>
				</div>
				<div class="card-body p-3 p-md-4">
					<div style="height: 250px; position: relative;">
						<canvas id="chartTicketsPriority"></canvas>
					</div>
				</div>
			</div>
		</div>

		<!-- Gráfico de Pastel / Donut: Activos TI por Categoría -->
		<div class="col-12 col-lg-6">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100">
				<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
					<div>
						<h6 class="fw-bold text-dark mb-0">Infraestructura TI por Categoría (CMDB)</h6>
						<div class="text-muted small" style="font-size: 11px;">Inventario distribuido de servidores, red y servicios</div>
					</div>
					<a href="{{ path('app_cmdb_asset_index') }}" class="small text-decoration-none fw-semibold" style="color: var(--panel, #14212B);">Ver Activos &rarr;</a>
				</div>
				<div class="card-body p-3 p-md-4">
					<div style="height: 250px; position: relative;">
						<canvas id="chartCisCategory"></canvas>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- =========================================================================
	     FILA 4: TABLA DE INCIDENTES RECIENTES & ESTADO DE SERVICIOS
	     ========================================================================= -->
	<div class="row g-4 mb-4">
		<!-- Tabla de Tickets Recientes -->
		<div class="col-12 col-xl-8">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100 overflow-hidden">
				<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
					<div>
						<h6 class="fw-bold text-dark mb-0">Tickets Recientes Registrados</h6>
						<div class="text-muted small" style="font-size: 11px;">Últimos requerimientos ingresados en mesa de ayuda</div>
					</div>
					<a href="{{ path('app_ticket_index') }}" class="small text-decoration-none fw-semibold" style="color: var(--panel, #14212B);">Gestionar Tickets &rarr;</a>
				</div>
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0" style="font-size: 13px;">
						<thead class="table-light text-secondary text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
							<tr>
								<th class="ps-3 py-3">Código</th>
								<th class="py-3">Título / Requerimiento</th>
								<th class="py-3">Prioridad</th>
								<th class="py-3">Estado</th>
								<th class="py-3 text-end pe-3">Acción</th>
							</tr>
						</thead>
						<tbody>
							{% for t in recent_tickets %}
								<tr>
									<td class="ps-3 py-3">
										<span class="fw-bold text-dark">{{ t.ticketCode }}</span>
										<div class="text-muted small" style="font-size: 11px;">{{ t.createdAt|date('d/m/Y H:i') }}</div>
									</td>
									<td class="py-3" style="max-width: 280px;">
										<div class="fw-semibold text-dark text-truncate" title="{{ t.title }}">{{ t.title }}</div>
										<div class="text-muted small text-truncate" style="font-size: 11px;">
											{{ t.requester ? t.requester.name|default(t.requester.email) : 'Anónimo' }}
										</div>
									</td>
									<td class="py-3">
										<span class="fw-semibold small" style="color: {{ t.priority ? t.priority.color|default('#64748b') : '#64748b' }};">
											{{ t.priority ? t.priority.name : 'N/A' }}
										</span>
									</td>
									<td class="py-3">
										<span class="small fw-semibold" style="color: var(--panel, #14212B);">
											{{ t.status ? t.status.name : 'Nuevo' }}
										</span>
									</td>
									<td class="py-3 text-end pe-3">
										<a href="{{ path('app_ticket_index') }}" class="btn btn-sm btn-outline-panel" title="Ir al ticket">
											<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
												<polyline points="15 3 21 3 21 9"/>
												<line x1="10" y1="14" x2="21" y2="3"/>
											</svg>
										</a>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center py-4 text-muted small">
										No hay tickets recientes para mostrar.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Estado de Servicios y Salud de Plataforma -->
		<div class="col-12 col-xl-4">
			<div class="card border-0 shadow-sm rounded-3 bg-white h-100">
				<div class="card-header bg-white border-bottom p-3">
					<h6 class="fw-bold text-dark mb-0">Salud y Estado del Sistema</h6>
					<div class="text-muted small" style="font-size: 11px;">Monitoreo de componentes centrales de GPI</div>
				</div>
				<div class="card-body p-3 p-md-4">
					<div class="d-flex flex-column gap-3">
						<!-- Item 1: Base de Datos -->
						<div class="d-flex align-items-center justify-content-between p-2.5 rounded-2 bg-light border">
							<div class="d-flex align-items-center gap-2.5">
								<div class="d-flex align-items-center justify-content-center rounded-2 text-dark" style="width: 32px; height: 32px; background-color: #e2e8f0;">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<ellipse cx="12" cy="5" rx="9" ry="3"/>
										<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
										<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
									</svg>
								</div>
								<div>
									<div class="fw-bold small text-dark">Base de Datos MySQL</div>
									<div class="text-muted" style="font-size: 11px;">Motor MariaDB / Conectado</div>
								</div>
							</div>
							<span class="small fw-semibold text-success d-inline-flex align-items-center gap-1.5">
								<span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
								Activo
							</span>
						</div>

						<!-- Item 2: Motor SLA -->
						<div class="d-flex align-items-center justify-content-between p-2.5 rounded-2 bg-light border">
							<div class="d-flex align-items-center gap-2.5">
								<div class="d-flex align-items-center justify-content-center rounded-2 text-dark" style="width: 32px; height: 32px; background-color: #e2e8f0;">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="12" cy="12" r="10"/>
										<polyline points="12 6 12 12 16 14"/>
									</svg>
								</div>
								<div>
									<div class="fw-bold small text-dark">Motor de Acuerdos SLA</div>
									<div class="text-muted" style="font-size: 11px;">Cálculo en tiempo real</div>
								</div>
							</div>
							<span class="small fw-semibold text-success d-inline-flex align-items-center gap-1.5">
								<span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
								Operativo
							</span>
						</div>

						<!-- Item 3: Servidor Web -->
						<div class="d-flex align-items-center justify-content-between p-2.5 rounded-2 bg-light border">
							<div class="d-flex align-items-center gap-2.5">
								<div class="d-flex align-items-center justify-content-center rounded-2 text-dark" style="width: 32px; height: 32px; background-color: #e2e8f0;">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
										<rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
										<line x1="6" y1="6" x2="6.01" y2="6"/>
										<line x1="6" y1="18" x2="6.01" y2="18"/>
									</svg>
								</div>
								<div>
									<div class="fw-bold small text-dark">Servidor PHP 8.5 / Caddy</div>
									<div class="text-muted" style="font-size: 11px;">FrankenPHP Worker</div>
								</div>
							</div>
							<span class="small fw-semibold text-success d-inline-flex align-items-center gap-1.5">
								<span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
								Activo
							</span>
						</div>

						<!-- Item 4: Zona Horaria -->
						<div class="d-flex align-items-center justify-content-between p-2.5 rounded-2 bg-light border">
							<div class="d-flex align-items-center gap-2.5">
								<div class="d-flex align-items-center justify-content-center rounded-2 text-dark" style="width: 32px; height: 32px; background-color: #e2e8f0;">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="12" cy="12" r="10"/>
										<line x1="2" y1="12" x2="22" y2="12"/>
										<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
									</svg>
								</div>
								<div>
									<div class="fw-bold small text-dark">Zona Horaria</div>
									<div class="text-muted" style="font-size: 11px;">America/Guayaquil (UTC-5)</div>
								</div>
							</div>
							<span class="small fw-semibold text-secondary">Ecuador</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function() {
	let chartStatus = null;
	let chartSla = null;
	let chartPriority = null;
	let chartCis = null;

	function initDashboardCharts() {
		if (typeof Chart === 'undefined') {
			setTimeout(initDashboardCharts, 50);
			return;
		}

		// Paleta corporativa
		const panelColor = '#14212B';
		const fontConfig = { family: 'Plus Jakarta Sans, sans-serif' };

		// 1. Gráfico de Barras: Tickets por Estado
		const ctxStatus = document.getElementById('chartTicketsStatus');
		if (ctxStatus) {
			if (chartStatus) chartStatus.destroy();
			const statusLabels = {{ chart_tickets_status.labels|json_encode|raw }};
			const statusData = {{ chart_tickets_status.data|json_encode|raw }};

			chartStatus = new Chart(ctxStatus, {
				type: 'bar',
				data: {
					labels: statusLabels,
					datasets: [{
						label: 'Tickets',
						data: statusData,
						backgroundColor: [
							'#14212B', // Nuevo
							'#2563eb', // En Proceso
							'#f59e0b', // En Espera
							'#10b981', // Resuelto
							'#64748b'  // Cerrado
						],
						borderRadius: 6,
						borderSkipped: false,
						maxBarThickness: 42
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
						legend: { display: false },
						tooltip: {
							padding: 10,
							bodyFont: fontConfig,
							titleFont: fontConfig
						}
					},
					scales: {
						y: {
							beginAtZero: true,
							ticks: {
								stepSize: 1,
								font: fontConfig,
								color: '#64748b'
							},
							grid: {
								color: '#f1f5f9'
							}
						},
						x: {
							ticks: {
								font: fontConfig,
								color: '#14212B'
							},
							grid: { display: false }
						}
					}
				}
			});
		}

		// 2. Gráfico de Pastel / Donut: Cumplimiento SLA
		const ctxSla = document.getElementById('chartSlaCompliance');
		if (ctxSla) {
			if (chartSla) chartSla.destroy();
			const slaLabels = {{ chart_sla_compliance.labels|json_encode|raw }};
			const slaData = {{ chart_sla_compliance.data|json_encode|raw }};

			chartSla = new Chart(ctxSla, {
				type: 'doughnut',
				data: {
					labels: slaLabels,
					datasets: [{
						data: slaData,
						backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
						borderWidth: 2,
						borderColor: '#ffffff',
						hoverOffset: 4
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					cutout: '72%',
					plugins: {
						legend: {
							position: 'bottom',
							labels: {
								font: fontConfig,
								color: '#14212B',
								padding: 14,
								usePointStyle: true,
								pointStyle: 'circle'
							}
						},
						tooltip: {
							padding: 10,
							bodyFont: fontConfig
						}
					}
				}
			});
		}

		// 3. Gráfico de Barras: Volumen por Prioridad
		const ctxPriority = document.getElementById('chartTicketsPriority');
		if (ctxPriority) {
			if (chartPriority) chartPriority.destroy();
			const prioLabels = {{ chart_tickets_priority.labels|json_encode|raw }};
			const prioData = {{ chart_tickets_priority.data|json_encode|raw }};
			const prioColors = {{ chart_tickets_priority.colors|json_encode|raw }};

			chartPriority = new Chart(ctxPriority, {
				type: 'bar',
				data: {
					labels: prioLabels,
					datasets: [{
						label: 'Cantidad',
						data: prioData,
						backgroundColor: prioColors.length ? prioColors : ['#dc2626', '#f59e0b', '#2563eb', '#10b981'],
						borderRadius: 6,
						borderSkipped: false,
						maxBarThickness: 34
					}]
				},
				options: {
					indexAxis: 'y',
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
						legend: { display: false },
						tooltip: { padding: 10, bodyFont: fontConfig }
					},
					scales: {
						x: {
							beginAtZero: true,
							ticks: { stepSize: 1, font: fontConfig, color: '#64748b' },
							grid: { color: '#f1f5f9' }
						},
						y: {
							ticks: { font: fontConfig, color: '#14212B' },
							grid: { display: false }
						}
					}
				}
			});
		}

		// 4. Gráfico de Pastel / Donut: Activos TI por Categoría
		const ctxCis = document.getElementById('chartCisCategory');
		if (ctxCis) {
			if (chartCis) chartCis.destroy();
			const cisLabels = {{ chart_cis_category.labels|json_encode|raw }};
			const cisData = {{ chart_cis_category.data|json_encode|raw }};

			const palette = ['#14212B', '#0284c7', '#0d9488', '#f59e0b', '#8b5cf6', '#ec4899'];

			chartCis = new Chart(ctxCis, {
				type: 'pie',
				data: {
					labels: cisLabels.length ? cisLabels : ['Sin categorías'],
					datasets: [{
						data: cisData.length ? cisData : [1],
						backgroundColor: palette.slice(0, Math.max(cisLabels.length, 1)),
						borderWidth: 2,
						borderColor: '#ffffff',
						hoverOffset: 4
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
						legend: {
							position: 'right',
							labels: {
								font: fontConfig,
								color: '#14212B',
								padding: 12,
								usePointStyle: true,
								pointStyle: 'circle'
							}
						},
						tooltip: { padding: 10, bodyFont: fontConfig }
					}
				}
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initDashboardCharts);
	} else {
		initDashboardCharts();
	}
	document.addEventListener('turbo:load', initDashboardCharts);
})();
</script>
{% endblock %}
