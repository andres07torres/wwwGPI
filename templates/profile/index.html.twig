{% extends 'layout.html.twig' %}

{% block title %}GPI · Mi Perfil de Usuario{% endblock %}

{% block content %}
<div class="user-module-wrapper">
	<!-- Encabezado con Título y Navegación de Migas de Pan -->
	<div class="mb-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-2 small">
				<li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Inicio</a></li>
				<li class="breadcrumb-item text-muted">Usuarios</li>
				<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Mi Perfil</li>
			</ol>
		</nav>
		<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
			<div>
				<h1 class="h3 fw-bold text-dark mb-1">Mi Perfil de Usuario</h1>
				<p class="text-muted mb-0">
					Gestiona tu información de cuenta, actualiza tu foto de perfil y resguarda la seguridad de tu contraseña de acceso.
				</p>
			</div>
			<div class="flex-shrink-0 d-flex gap-2">
				{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
					<a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 rounded-3 px-3 py-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
						</svg>
						<span>Directorio de Usuarios</span>
					</a>
				{% endif %}
			</div>
		</div>
	</div>

	<!-- Tarjeta Resumen del Perfil -->
	<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden profile-summary-card">
		<div class="card-body p-4 p-md-4">
			<div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4">
				<!-- Avatar Grande del Usuario -->
				<div class="position-relative">
					{% if user.avatarPath %}
						<img src="{{ asset(user.avatarPath) }}" alt="{{ user.name }}" class="profile-avatar-xl rounded-circle shadow-sm" id="summaryAvatarImg">
					{% else %}
						<div class="profile-avatar-xl-fallback rounded-circle shadow-sm" id="summaryAvatarFallback">
							{{ (user.name|default(user.username)|slice(0, 2))|upper }}
						</div>
					{% endif %}
					<span class="position-absolute bottom-0 end-0 translate-middle-x p-2 bg-success border border-white rounded-circle shadow-sm" title="Usuario Activo">
						<span class="visually-hidden">En línea</span>
					</span>
				</div>

				<!-- Datos Principales -->
				<div class="flex-grow-1 text-center text-sm-start min-w-0">
					<div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-baseline gap-2 mb-1">
						<h2 class="h4 fw-bold text-dark mb-0">{{ user.name }}</h2>
						<span class="text-muted small">@{{ user.username }}</span>
					</div>
					<div class="text-muted small mb-2">{{ user.email }}</div>

					<!-- Metadatos de la cuenta en texto plano e iconos, sin apariencia de botón -->
					<div class="d-flex flex-wrap justify-content-center justify-content-sm-start align-items-center gap-3 small text-secondary">
						<div class="d-inline-flex align-items-center gap-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
							</svg>
							<span>Rol: <strong class="text-dark">{{ user.role ? user.role.name : 'Usuario Estándar' }}</strong></span>
						</div>
						<span class="text-muted opacity-50 d-none d-sm-inline">&bull;</span>
						<div class="d-inline-flex align-items-center gap-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
								<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
								<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
							</svg>
							<span>Organización: <strong class="text-dark">{{ user.tenant ? user.tenant.name : 'Principal' }}</strong></span>
						</div>
						<span class="text-muted opacity-50 d-none d-sm-inline">&bull;</span>
						<div class="d-inline-flex align-items-center gap-1">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
								<circle cx="12" cy="12" r="10"/>
								<polyline points="12 6 12 12 16 14"/>
							</svg>
							<span>Miembro desde: <strong class="text-dark">{{ user.createdAt|date('M Y') }}</strong></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Pestañas de Navegación del Submódulo -->
	<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
		<div class="card-header bg-white border-bottom p-0">
			<ul class="nav nav-tabs profile-nav-tabs border-0 px-3 pt-2 justify-content-center" id="profileTabs" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link profile-tab-link {{ activeTab == 'info' ? 'active' : '' }}" 
							id="tab-info-btn" 
							data-bs-toggle="tab" 
							data-bs-target="#tab-info" 
							type="button" 
							role="tab" 
							aria-controls="tab-info" 
							aria-selected="{{ activeTab == 'info' ? 'true' : 'false' }}">
						<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
							<circle cx="12" cy="7" r="4"/>
						</svg>
						<span>Información Personal</span>
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link profile-tab-link {{ activeTab == 'avatar' ? 'active' : '' }}" 
							id="tab-avatar-btn" 
							data-bs-toggle="tab" 
							data-bs-target="#tab-avatar" 
							type="button" 
							role="tab" 
							aria-controls="tab-avatar" 
							aria-selected="{{ activeTab == 'avatar' ? 'true' : 'false' }}">
						<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
							<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
							<circle cx="12" cy="13" r="3"/>
						</svg>
						<span>Foto de Perfil</span>
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link profile-tab-link {{ activeTab == 'security' ? 'active' : '' }}" 
							id="tab-security-btn" 
							data-bs-toggle="tab" 
							data-bs-target="#tab-security" 
							type="button" 
							role="tab" 
							aria-controls="tab-security" 
							aria-selected="{{ activeTab == 'security' ? 'true' : 'false' }}">
						<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
						</svg>
						<span>Cambiar Contraseña</span>
					</button>
				</li>
			</ul>
		</div>

		<div class="card-body p-4 p-md-5">
			<div class="tab-content" id="profileTabsContent">
				
				{# =============================================================
				   PESTAÑA 1: INFORMACIÓN PERSONAL
				   ============================================================= #}
				<div class="tab-pane fade {{ activeTab == 'info' ? 'show active' : '' }}" id="tab-info" role="tabpanel" aria-labelledby="tab-info-btn">
					<div class="row justify-content-center">
						<div class="col-lg-8 col-xl-7">
							<div class="mb-4">
								<h3 class="h5 fw-bold text-dark mb-1">Datos de tu Cuenta</h3>
								<p class="text-muted small mb-0">Mantén actualizados tus datos de identificación y contacto para notificaciones del sistema.</p>
							</div>

							<form action="{{ path('app_profile_update_info') }}" method="post" id="formProfileInfo">
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_info') }}">

								<div class="mb-3">
									<label for="profile_name" class="form-label small fw-semibold text-secondary">Nombre Completo <span class="text-danger">*</span></label>
									<input type="text" class="form-control py-2" id="profile_name" name="name" value="{{ user.name }}" required minlength="3" maxlength="120" placeholder="Escribe tu nombre completo">
								</div>

								<div class="row g-3 mb-3">
									<div class="col-md-6">
										<label for="profile_username" class="form-label small fw-semibold text-secondary">Nombre de Usuario <span class="text-danger">*</span></label>
										<div class="input-group">
											<span class="input-group-text bg-light text-muted">@</span>
											<input type="text" class="form-control py-2" id="profile_username" name="username" value="{{ user.username }}" required minlength="3" maxlength="60" placeholder="usuario">
										</div>
										<div class="form-text text-muted" style="font-size: 11px;">Solo letras, números, puntos y guiones.</div>
									</div>
									<div class="col-md-6">
										<label for="profile_email" class="form-label small fw-semibold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
										<input type="email" class="form-control py-2" id="profile_email" name="email" value="{{ user.email }}" required placeholder="nombre@empresa.com">
										<div class="form-text text-muted" style="font-size: 11px;">Recibirás alertas y notificaciones aquí.</div>
									</div>
								</div>

								<!-- Campos Informativos de Solo Lectura -->
								<div class="p-3 bg-light rounded-3 border mb-4">
									<div class="small fw-semibold text-secondary mb-2">Información del Sistema (Asignada por Administrador)</div>
									<div class="row g-2 small">
										<div class="col-sm-6">
											<span class="text-muted">Rol de Acceso:</span>
											<strong class="text-dark d-block">{{ user.role ? user.role.name : 'Usuario Estándar' }}</strong>
										</div>
										<div class="col-sm-6">
											<span class="text-muted">Organización / Tenant:</span>
											<strong class="text-dark d-block">{{ user.tenant ? user.tenant.name : 'Tenant Predeterminado' }}</strong>
										</div>
									</div>
								</div>

								<div class="d-flex justify-content-center align-items-center gap-3 pt-2">
									<button type="submit" class="btn btn-panel-action px-4 py-2">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
											<polyline points="17 21 17 13 7 13 7 21"/>
											<polyline points="7 3 7 8 15 8"/>
										</svg>
										<span>Guardar Cambios</span>
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>

				{# =============================================================
				   PESTAÑA 2: CAMBIAR FOTO DE PERFIL
				   ============================================================= #}
				<div class="tab-pane fade {{ activeTab == 'avatar' ? 'show active' : '' }}" id="tab-avatar" role="tabpanel" aria-labelledby="tab-avatar-btn">
					<div class="row justify-content-center">
						<div class="col-lg-8 col-xl-7">
							<div class="mb-4">
								<h3 class="h5 fw-bold text-dark mb-1">Foto de Perfil</h3>
								<p class="text-muted small mb-0">Personaliza la imagen que otros usuarios y especialistas verán en tickets, asignaciones y comentarios.</p>
							</div>

							<!-- Vista previa e interactividad de subida -->
							<div class="d-flex flex-column flex-sm-row align-items-center gap-4 mb-4 p-3 bg-light rounded-3 border">
								<div class="position-relative">
									<div class="avatar-preview-box rounded-circle shadow-sm overflow-hidden" style="width: 110px; height: 110px; border: 3px solid #FFFFFF;">
										<img src="{{ user.avatarPath ? asset(user.avatarPath) : '/images/avatar-default.svg' }}" 
											 alt="Foto de perfil actual" 
											 id="avatarLivePreview" 
											 style="width: 100%; height: 100%; object-fit: cover;">
									</div>
								</div>
								<div>
									<div class="fw-semibold text-dark mb-1">Previsualización de Foto</div>
									<div class="text-muted small mb-1">
										Se mostrará recortada de forma circular en la barra de navegación y comentarios.
									</div>
									<div class="text-secondary small" style="font-size: 12px;">Resolución recomendada: 400 &times; 400 px</div>
								</div>
							</div>

							<form action="{{ path('app_profile_update_avatar') }}" method="post" enctype="multipart/form-data" id="formProfileAvatar">
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar') }}">

								<div class="mb-4">
									<label for="avatar_file_input" class="form-label small fw-semibold text-secondary">Seleccionar Nueva Imagen</label>
									<input class="form-control py-2" type="file" id="avatar_file_input" name="avatar" accept="image/png, image/jpeg, image/webp, image/gif" required>
									<div class="form-text text-muted small mt-2">
										Formatos permitidos: <strong>JPG, PNG, WEBP o GIF</strong>. Tamaño máximo: <strong>4 MB</strong>.
									</div>
								</div>

								<div class="d-flex justify-content-center align-items-center gap-2 pt-2">
									<button type="submit" class="btn btn-panel-action px-4 py-2" id="btnSubmitAvatar" disabled>
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
											<polyline points="17 8 12 3 7 8"/>
											<line x1="12" y1="3" x2="12" y2="15"/>
										</svg>
										<span>Subir Nueva Foto</span>
									</button>
								</div>
							</form>

							{% if user.avatarPath %}
								<hr class="my-4">
								<div class="d-flex flex-column flex-sm-row align-items-center justify-content-between text-center text-sm-start gap-3 p-3 rounded-3 bg-danger-subtle border border-danger-subtle">
									<div>
										<div class="fw-semibold text-danger small">Restablecer a Imagen Predeterminada</div>
										<div class="text-muted" style="font-size: 12px;">Elimina tu foto actual y utiliza las iniciales automáticas.</div>
									</div>
									<form action="{{ path('app_profile_remove_avatar') }}" method="post" id="formRemoveAvatar" class="d-flex justify-content-center" onsubmit="return confirm('¿Estás seguro de que deseas eliminar tu foto de perfil?');">
										<input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_remove_avatar') }}">
										<button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
												<polyline points="3 6 5 6 21 6"/>
												<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
											</svg>
											<span>Eliminar Foto</span>
										</button>
									</form>
								</div>
							{% endif %}
						</div>
					</div>
				</div>

				{# =============================================================
				   PESTAÑA 3: CAMBIAR CONTRASEÑA
				   ============================================================= #}
				<div class="tab-pane fade {{ activeTab == 'security' ? 'show active' : '' }}" id="tab-security" role="tabpanel" aria-labelledby="tab-security-btn">
					<div class="row justify-content-center">
						<div class="col-lg-8 col-xl-7">
							<div class="mb-4">
								<h3 class="h5 fw-bold text-dark mb-1">Seguridad de la Contraseña</h3>
								<p class="text-muted small mb-0">Cambia periódicamente tu contraseña para proteger tu cuenta y la información corporativa.</p>
							</div>

							<form action="{{ path('app_profile_update_password') }}" method="post" id="formProfilePassword">
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_password') }}">

								<div class="mb-3">
									<label for="current_password" class="form-label small fw-semibold text-secondary">Contraseña Actual <span class="text-danger">*</span></label>
									<div class="input-group">
										<input type="password" class="form-control py-2 password-input" id="current_password" name="current_password" required placeholder="Ingresa tu contraseña actual">
										<button class="btn btn-outline-secondary btn-toggle-password" type="button" data-target="current_password" aria-label="Mostrar u ocultar contraseña">
											<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
												<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
												<circle cx="12" cy="12" r="3"/>
											</svg>
										</button>
									</div>
								</div>

								<div class="row g-3 mb-3">
									<div class="col-md-6">
										<label for="new_password" class="form-label small fw-semibold text-secondary">Nueva Contraseña <span class="text-danger">*</span></label>
										<div class="input-group">
											<input type="password" class="form-control py-2 password-input" id="new_password" name="new_password" required minlength="8" placeholder="Mínimo 8 caracteres">
											<button class="btn btn-outline-secondary btn-toggle-password" type="button" data-target="new_password" aria-label="Mostrar u ocultar contraseña">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
													<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
													<circle cx="12" cy="12" r="3"/>
												</svg>
											</button>
										</div>
									</div>
									<div class="col-md-6">
										<label for="confirm_password" class="form-label small fw-semibold text-secondary">Confirmar Nueva Contraseña <span class="text-danger">*</span></label>
										<div class="input-group">
											<input type="password" class="form-control py-2 password-input" id="confirm_password" name="confirm_password" required minlength="8" placeholder="Repite la nueva contraseña">
											<button class="btn btn-outline-secondary btn-toggle-password" type="button" data-target="confirm_password" aria-label="Mostrar u ocultar contraseña">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon">
													<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
													<circle cx="12" cy="12" r="3"/>
												</svg>
											</button>
										</div>
									</div>
								</div>

								<div id="passwordMismatchWarning" class="alert alert-danger py-2 px-3 small d-none mb-3">
									Las contraseñas no coinciden. Por favor, asegúrate de escribir la misma contraseña en ambos campos.
								</div>

								<div class="p-3 bg-light rounded-3 border mb-4">
									<div class="small fw-semibold text-secondary mb-2">Requisitos de seguridad recomendados:</div>
									<ul class="text-muted small ps-3 mb-0" style="font-size: 12px;">
										<li id="req_len">Al menos 8 caracteres de longitud.</li>
										<li id="req_diff">Diferente a la contraseña actual.</li>
										<li>Se recomienda incluir una combinación de letras, números y símbolos.</li>
									</ul>
								</div>

								<div class="d-flex justify-content-center align-items-center gap-3 pt-2">
									<button type="submit" class="btn btn-panel-action px-4 py-2" id="btnSubmitPassword">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
											<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
										</svg>
										<span>Actualizar Contraseña</span>
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function() {
	function initProfileModule() {
		// 1. Previsualización de Foto de Perfil antes de subir
		const avatarInput = document.getElementById('avatar_file_input');
		const livePreview = document.getElementById('avatarLivePreview');
		const btnSubmitAvatar = document.getElementById('btnSubmitAvatar');

		if (avatarInput && !avatarInput.dataset.initialized) {
			avatarInput.dataset.initialized = 'true';
			avatarInput.addEventListener('change', function(e) {
				const file = this.files[0];
				if (file) {
					if (file.size > 4 * 1024 * 1024) {
						if (typeof Swal !== 'undefined') {
							Swal.fire({
								icon: 'warning',
								title: 'Archivo muy grande',
								text: 'La imagen supera los 4 MB permitidos. Elige un archivo más liviano.',
								confirmButtonColor: '#14212B'
							});
						} else {
							alert('La imagen supera los 4 MB permitidos.');
						}
						this.value = '';
						if (btnSubmitAvatar) btnSubmitAvatar.disabled = true;
						return;
					}

					const reader = new FileReader();
					reader.onload = function(evt) {
						if (livePreview) livePreview.src = evt.target.result;
						if (btnSubmitAvatar) btnSubmitAvatar.disabled = false;
					};
					reader.readAsDataURL(file);
				} else {
					if (btnSubmitAvatar) btnSubmitAvatar.disabled = true;
				}
			});
		}

		// 2. Alternar visibilidad de contraseñas (ojito)
		document.querySelectorAll('.btn-toggle-password').forEach(btn => {
			if (btn.dataset.initialized) return;
			btn.dataset.initialized = 'true';
			btn.addEventListener('click', function() {
				const targetId = this.dataset.target;
				const input = document.getElementById(targetId);
				if (!input) return;

				if (input.type === 'password') {
					input.type = 'text';
					this.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>`;
				} else {
					input.type = 'password';
					this.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`;
				}
			});
		});

		// 3. Validación en tiempo real de contraseñas
		const newPassInput = document.getElementById('new_password');
		const confirmPassInput = document.getElementById('confirm_password');
		const mismatchWarning = document.getElementById('passwordMismatchWarning');
		const formPassword = document.getElementById('formProfilePassword');

		function validatePasswordsMatch() {
			if (!newPassInput || !confirmPassInput || !mismatchWarning) return;
			if (confirmPassInput.value && newPassInput.value !== confirmPassInput.value) {
				mismatchWarning.classList.remove('d-none');
			} else {
				mismatchWarning.classList.add('d-none');
			}
		}

		if (newPassInput && !newPassInput.dataset.initialized) {
			newPassInput.dataset.initialized = 'true';
			newPassInput.addEventListener('input', validatePasswordsMatch);
		}
		if (confirmPassInput && !confirmPassInput.dataset.initialized) {
			confirmPassInput.dataset.initialized = 'true';
			confirmPassInput.addEventListener('input', validatePasswordsMatch);
		}

		if (formPassword && !formPassword.dataset.initialized) {
			formPassword.dataset.initialized = 'true';
			formPassword.addEventListener('submit', function(e) {
				if (newPassInput && confirmPassInput && newPassInput.value !== confirmPassInput.value) {
					e.preventDefault();
					if (mismatchWarning) mismatchWarning.classList.remove('d-none');
					confirmPassInput.focus();
				}
			});
		}

		// 4. Soporte para hash en la URL (ej. /profile#avatar o /profile#security)
		function activateTabFromUrl() {
			const hash = window.location.hash.replace('#', '');
			if (hash && ['info', 'avatar', 'security'].includes(hash)) {
				const tabTrigger = document.getElementById(`tab-${hash}-btn`);
				if (tabTrigger && typeof bootstrap !== 'undefined' && bootstrap.Tab) {
					const tab = new bootstrap.Tab(tabTrigger);
					tab.show();
				}
			}
		}
		activateTabFromUrl();
		window.addEventListener('hashchange', activateTabFromUrl);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProfileModule);
	} else {
		initProfileModule();
	}
	document.addEventListener('turbo:load', initProfileModule);
})();
</script>
{% endblock %}
