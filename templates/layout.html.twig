{% extends 'base.html.twig' %}

{% block body %}
<div class="app-layout">
	{# =====================================================================
	   NAVBAR A LA IZQUIERDA (SIDEBAR)
	   Bootstrap 5 offcanvas-lg para soporte nativo responsive en móviles
	   ===================================================================== #}
	<aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
		<!-- Cabecera del Sidebar con Logo Centrado -->
		<div class="sidebar-header justify-content-center position-relative">
			<a href="{{ path('app_home') }}" class="sidebar-brand mx-auto text-center">
				<img src="/images/logo-white.svg?v=2" alt="Logo GPI" class="sidebar-logo mx-auto">
			</a>
			<!-- Botón cerrar solo visible en dispositivos móviles -->
			<button type="button" class="btn-close btn-close-white d-lg-none position-absolute end-0 me-3" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Cerrar"></button>
		</div>

		<!-- Menú de navegación scrollable con los módulos y sus submódulos -->
		<div class="sidebar-body">
			<!-- Enlace Directo: Panel Principal -->
			<ul class="sidebar-nav mb-2">
				<li>
					<a href="{{ path('app_home') }}" class="sidebar-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect width="7" height="9" x="3" y="3" rx="1"/>
							<rect width="7" height="5" x="14" y="3" rx="1"/>
							<rect width="7" height="9" x="14" y="12" rx="1"/>
							<rect width="7" height="5" x="3" y="16" rx="1"/>
						</svg>
						<span>Dashboard</span>
					</a>
				</li>
			</ul>

			<!-- Sección: Sistema -->
			<div class="sidebar-section-title">Sistema</div>
			<ul class="sidebar-nav">
				<!-- 1. Mesa de Ayuda -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuMesaAyuda" role="button" aria-expanded="false" aria-controls="menuMesaAyuda">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
							<line x1="9" x2="9" y1="9" y2="15"/>
							<line x1="15" x2="15" y1="9" y2="15"/>
						</svg>
						<span>Mesa de Ayuda</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuMesaAyuda">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Ingesta (IMAP / Webhooks)</a></li>
							<li><a href="#" class="sidebar-sublink">Clasificador</a></li>
							<li><a href="#" class="sidebar-sublink">Tablero Kanban</a></li>
							<li><a href="#" class="sidebar-sublink">Chat (Cliente / Técnico)</a></li>
						</ul>
					</div>
				</li>

				<!-- 2. CMDB -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuCMDB" role="button" aria-expanded="false" aria-controls="menuCMDB">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
							<rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
							<line x1="6" y1="6" x2="6.01" y2="6"/>
							<line x1="6" y1="18" x2="6.01" y2="18"/>
						</svg>
						<span>CMDB</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuCMDB">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Activos Físicos</a></li>
							<li><a href="#" class="sidebar-sublink">Activos Lógicos</a></li>
							<li><a href="#" class="sidebar-sublink">Mapa de Topología</a></li>
						</ul>
					</div>
				</li>

				<!-- 3. Motor SLA -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuSLA" role="button" aria-expanded="false" aria-controls="menuSLA">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polyline points="12 6 12 12 16 14"/>
						</svg>
						<span>Motor SLA</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuSLA">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Políticas & Matrices</a></li>
							<li><a href="#" class="sidebar-sublink">Cronómetros (Workers)</a></li>
							<li><a href="#" class="sidebar-sublink">Automatización & Alertas</a></li>
						</ul>
					</div>
				</li>

				<!-- 4. Operaciones -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuOperaciones" role="button" aria-expanded="false" aria-controls="menuOperaciones">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
						</svg>
						<span>Operaciones</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuOperaciones">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Gestión de Problemas</a></li>
							<li><a href="#" class="sidebar-sublink">Aprobaciones (Comité CAB)</a></li>
							<li><a href="#" class="sidebar-sublink">Calendario Mantenimiento</a></li>
						</ul>
					</div>
				</li>

				<!-- 5. Wiki -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuWiki" role="button" aria-expanded="false" aria-controls="menuWiki">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
						</svg>
						<span>Wiki</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuWiki">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Autoservicio (Clientes)</a></li>
							<li><a href="#" class="sidebar-sublink">Procedimientos (Agentes)</a></li>
						</ul>
					</div>
				</li>

				<!-- 6. Core -->
				<li>
					<a class="sidebar-link" data-bs-toggle="collapse" href="#menuCore" role="button" aria-expanded="false" aria-controls="menuCore">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
						</svg>
						<span>Core</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse" id="menuCore">
						<ul class="sidebar-submenu">
							<li><a href="#" class="sidebar-sublink">Tenants (Multicliente)</a></li>
							<li><a href="#" class="sidebar-sublink">Control de Acceso (RBAC)</a></li>
							<li><a href="#" class="sidebar-sublink">Auditoría (Logs)</a></li>
						</ul>
					</div>
				</li>
			</ul>

			<!-- Sección: Usuarios -->
			<div class="sidebar-section-title">Usuarios</div>
			<ul class="sidebar-nav">
				{% set is_user_route = app.request.attributes.get('_route') starts with 'app_user_' %}
				<li>
					<a class="sidebar-link {{ is_user_route ? 'active' : '' }}" data-bs-toggle="collapse" href="#menuUsuarios" role="button" aria-expanded="{{ is_user_route ? 'true' : 'false' }}" aria-controls="menuUsuarios">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
						</svg>
						<span>Usuarios</span>
						<svg class="sidebar-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</a>
					<div class="collapse {{ is_user_route ? 'show' : '' }}" id="menuUsuarios">
						<ul class="sidebar-submenu">
							<li><a href="{{ path('app_user_index') }}" class="sidebar-sublink {{ app.request.attributes.get('_route') == 'app_user_index' ? 'active' : '' }}">Gestión de Usuarios</a></li>
						</ul>
					</div>
				</li>
			</ul>
		</div>

		<!-- Pie del Sidebar con Perfil de Usuario y Logout -->
		<div class="sidebar-footer">
			<div class="sidebar-user">
				<div class="sidebar-avatar">
					{{ app.user ? (app.user.name|default(app.user.userIdentifier)|slice(0, 2)|upper) : 'GP' }}
					<span class="status-dot" title="En línea"></span>
				</div>
				<div class="sidebar-user-info">
					<div class="sidebar-user-name" title="{{ app.user ? app.user.name|default(app.user.userIdentifier) : 'Administrador' }}">
						{{ app.user ? app.user.name|default(app.user.userIdentifier) : 'Administrador' }}
					</div>
					<div class="sidebar-user-role">
						{% if app.user %}
							{% if 'ROLE_SUPER_ADMIN' in app.user.roles %}
								Super Admin
							{% elseif 'ROLE_ADMIN' in app.user.roles %}
								Administrador
							{% elseif 'ROLE_AGENT' in app.user.roles %}
								Especialista TI
							{% else %}
								Usuario
							{% endif %}
						{% else %}
							Invitado
						{% endif %}
					</div>
				</div>
			</div>
			<a href="{{ path('app_logout') }}" class="sidebar-logout-btn" title="Cerrar sesión" aria-label="Cerrar sesión">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
					<polyline points="16 17 21 12 16 7"/>
					<line x1="21" x2="9" y1="12" y2="12"/>
				</svg>
			</a>
		</div>
	</aside>

	{# =====================================================================
	   ÁREA DE CONTENIDO PRINCIPAL
	   ===================================================================== #}
	<div class="app-main">
		<!-- Barra superior (Topbar personalizada) -->
		<header class="app-topbar">
			<div class="d-flex align-items-center gap-2">
				<!-- Botón para abrir el sidebar en pantallas móviles (< lg) -->
				<button class="btn btn-sm btn-outline-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Abrir menú">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
						<line x1="3" y1="12" x2="21" y2="12"/>
						<line x1="3" y1="6" x2="21" y2="6"/>
						<line x1="3" y1="18" x2="21" y2="18"/>
					</svg>
				</button>
			</div>

			<!-- Acciones a la derecha: Reloj Ecuador, Campanita de notificaciones y Perfil con desplegable -->
			<div class="d-flex align-items-center gap-3 ms-auto">
				<!-- Reloj Simple Ecuador / Guayaquil (UTC-5) -->
				<div class="topbar-clock-simple me-1" data-controller="clock" title="Hora de Guayaquil, Ecuador (UTC-5)">
					<span id="topbarClock" data-clock-target="time">{{ "now"|date("g:i A", "America/Guayaquil") }}</span>
				</div>

				<!-- Campanita de Notificaciones con Desplegable -->
				<div class="dropdown">
					<button class="topbar-action-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones" aria-label="Notificaciones">
						<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
							<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
						</svg>
					</button>
					<div class="dropdown-menu dropdown-menu-end notifications-dropdown-menu" aria-labelledby="notifDropdown">
						<div class="p-3 border-bottom d-flex align-items-center justify-content-between">
							<span class="fw-bold text-dark small">Notificaciones</span>
							<span class="badge bg-light text-muted border">Al día</span>
						</div>
						<div class="p-4 text-center text-muted small">
							<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 text-secondary opacity-50"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
							<div>No tienes notificaciones pendientes</div>
						</div>
					</div>
				</div>

				<!-- Foto de Usuario con Menú Desplegable -->
				<div class="dropdown">
					<button class="topbar-user-trigger" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de usuario">
						<img src="/images/avatar-default.svg" alt="Usuario" class="topbar-user-avatar">
					</button>
					<div class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuDropdown">
						<!-- Cabecera del usuario: Foto, Nombre completo y Correo -->
						<div class="user-dropdown-header">
							<img src="/images/avatar-default.svg" alt="Usuario" class="user-dropdown-avatar">
							<div class="min-w-0">
								<div class="user-dropdown-name" title="{{ app.user ? (app.user.name|default(app.user.userIdentifier)) : 'Usuario Administrador' }}">
									{{ app.user ? (app.user.name|default(app.user.userIdentifier)) : 'Usuario Administrador' }}
								</div>
								<div class="user-dropdown-email">
									{{ app.user and app.user.email ? app.user.email : 'admin@gpi.local' }}
								</div>
							</div>
						</div>

						<!-- Opciones del menú -->
						<div class="user-dropdown-body">
							<a class="user-dropdown-item" href="#">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
								<span>Gestionar mi perfil</span>
							</a>
							<a class="user-dropdown-item" href="#">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
								<span>Cambiar foto de perfil</span>
							</a>
							<a class="user-dropdown-item" href="#">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
								<span>Cambiar contraseña</span>
							</a>
							<hr class="dropdown-divider my-1">
							<a class="user-dropdown-item logout" href="{{ path('app_logout') }}">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
								<span>Cerrar Sesión</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</header>

		<script>
			(function() {
				function updateEcuadorClock() {
					try {
						const el = document.getElementById('topbarClock');
						if (!el) return;
						const now = new Date();
						const formatter = new Intl.DateTimeFormat('en-US', {
							timeZone: 'America/Guayaquil',
							hour: 'numeric',
							minute: '2-digit',
							hour12: true
						});
						el.textContent = formatter.format(now);
					} catch (e) {}
				}
				updateEcuadorClock();
				setInterval(updateEcuadorClock, 1000);
			})();
		</script>

		<!-- Contenedor del contenido -->
		<main class="app-content">
			{# Notificaciones Flash procesadas interactivamente con SweetAlert2 #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="app-flash-payload" 
						 data-type="{{ label == 'error' ? 'error' : (label == 'warning' ? 'warning' : 'success') }}" 
						 data-message="{{ message|e('html_attr') }}"
						 style="display:none;" 
						 aria-hidden="true"></div>
				{% endfor %}
			{% endfor %}

			{% block content %}{% endblock %}
		</main>
	</div>
</div>

<script>
	(function() {
		function runSweetAlertFlashes() {
			if (typeof Swal === 'undefined') {
				setTimeout(runSweetAlertFlashes, 60);
				return;
			}
			var flashEls = document.querySelectorAll('.app-flash-payload');
			if (!flashEls.length) return;

			flashEls.forEach(function(el) {
				var type = el.dataset.type || 'success';
				var message = el.dataset.message || '';
				if (message) {
					var title = '¡Operación Exitosa!';
					if (type === 'error') title = 'Error';
					else if (type === 'warning') title = 'Aviso';

					Swal.fire({
						icon: type,
						title: title,
						text: message,
						confirmButtonText: 'Aceptar',
						confirmButtonColor: '#14212B',
						timer: 3500,
						timerProgressBar: true
					});
				}
				el.remove();
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', runSweetAlertFlashes);
		} else {
			runSweetAlertFlashes();
		}
		document.addEventListener('turbo:load', runSweetAlertFlashes);
	})();
</script>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{% block page_scripts %}{% endblock %}
{% endblock %}
