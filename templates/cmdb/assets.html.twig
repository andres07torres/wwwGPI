							</select>
						</div>
					</div>

					<div class="row g-3 mb-3">
						<div class="col-md-6">
							<label for="edit_ci_category" class="form-label small fw-semibold text-secondary">Categoría del Activo <span class="text-danger">*</span></label>
							<select class="form-select" id="edit_ci_category" name="category_id" required>
