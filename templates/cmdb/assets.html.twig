{% block page_scripts %}
<script>
(function() {
	function initCiModalsAndFilters() {
		const searchInput = document.getElementById('ciSearchInput');
		const typeFilter = document.getElementById('filterType');
		const categoryFilter = document.getElementById('filterCategory');
		const statusFilter = document.getElementById('filterStatus');
		const rows = document.querySelectorAll('.ci-row');
		const pageSize = 10;
		let currentPage = 1;

		function updatePagination(matchingRows) {
			const total = matchingRows.length;
			const totalPages = Math.max(1, Math.ceil(total / pageSize));
			if (currentPage > totalPages) currentPage = totalPages;
			if (currentPage < 1) currentPage = 1;

			const startIndex = (currentPage - 1) * pageSize;
			const endIndex = Math.min(startIndex + pageSize, total);

			rows.forEach(r => r.style.display = 'none');
			for (let i = startIndex; i < endIndex; i++) {
				matchingRows[i].style.display = '';
			}

			const startEl = document.getElementById('ciPageStart');
			const endEl = document.getElementById('ciPageEnd');
			const totalEl = document.getElementById('ciPageTotal');
			const navEl = document.getElementById('ciPaginationNav');

			if (startEl) startEl.textContent = total === 0 ? '0' : (startIndex + 1);
			if (endEl) endEl.textContent = endIndex;
			if (totalEl) totalEl.textContent = total;

			if (navEl) {
				navEl.innerHTML = '';
				if (total <= pageSize && totalPages <= 1) {
					const singleLi = document.createElement('li');
					singleLi.className = 'page-item active';
					singleLi.innerHTML = `<button type="button" class="page-link">1</button>`;
					navEl.appendChild(singleLi);
					return;
				}

				// Botón Anterior
				const prevLi = document.createElement('li');
				prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
				prevLi.innerHTML = `<button type="button" class="page-link" aria-label="Anterior">&laquo; Anterior</button>`;
				prevLi.addEventListener('click', (e) => {
					e.preventDefault();
					if (currentPage > 1) {
						currentPage--;
						applyFilters(false);
					}
				});
				navEl.appendChild(prevLi);

				// Botones de página
				for (let p = 1; p <= totalPages; p++) {
					const pageLi = document.createElement('li');
					pageLi.className = `page-item ${p === currentPage ? 'active' : ''}`;
					pageLi.innerHTML = `<button type="button" class="page-link">${p}</button>`;
					pageLi.addEventListener('click', (e) => {
						e.preventDefault();
						currentPage = p;
						applyFilters(false);
					});
					navEl.appendChild(pageLi);
				}

				// Botón Siguiente
				const nextLi = document.createElement('li');
				nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
				nextLi.innerHTML = `<button type="button" class="page-link" aria-label="Siguiente">Siguiente &raquo;</button>`;
				nextLi.addEventListener('click', (e) => {
					e.preventDefault();
					if (currentPage < totalPages) {
						currentPage++;
						applyFilters(false);
					}
				});
				navEl.appendChild(nextLi);
			}
		}

		function applyFilters(resetPage = true) {
			if (resetPage) currentPage = 1;
			const searchTerm = (searchInput ? searchInput.value : '').toLowerCase().trim();
			const selectedType = (typeFilter ? typeFilter.value : '').toLowerCase().trim();
			const selectedCategory = (categoryFilter ? categoryFilter.value : '').toLowerCase().trim();
			const selectedStatus = (statusFilter ? statusFilter.value : '').toLowerCase().trim();

			const matchingRows = [];
			rows.forEach(row => {
				const searchData = (row.dataset.search || '').toLowerCase();
				const rowCategory = (row.dataset.categoryName || '').toLowerCase();
				const rowStatus = (row.dataset.status || '').toLowerCase();
				const rowType = (row.dataset.type || '').toLowerCase();

				const matchesSearch = !searchTerm || searchData.includes(searchTerm);
				const matchesType = !selectedType || rowType === selectedType;
				const matchesCategory = !selectedCategory || rowCategory.includes(selectedCategory);
				const matchesStatus = !selectedStatus || rowStatus === selectedStatus;

				if (matchesSearch && matchesType && matchesCategory && matchesStatus) {
					matchingRows.push(row);
				}
			});

			updatePagination(matchingRows);
		}

		if (searchInput && !searchInput.dataset.initialized) {
			searchInput.dataset.initialized = 'true';
			searchInput.addEventListener('input', () => applyFilters(true));
		}

		if (typeFilter && !typeFilter.dataset.initialized) {
			typeFilter.dataset.initialized = 'true';
			typeFilter.addEventListener('change', () => applyFilters(true));
		}

		if (categoryFilter && !categoryFilter.dataset.initialized) {
			categoryFilter.dataset.initialized = 'true';
			categoryFilter.addEventListener('change', () => applyFilters(true));
		}

		if (statusFilter && !statusFilter.dataset.initialized) {
			statusFilter.dataset.initialized = 'true';
			statusFilter.addEventListener('change', () => applyFilters(true));
		}

		applyFilters(true);

		// Modal Editar Activo (#modalEditCiItem)
		const modalEditEl = document.getElementById('modalEditCiItem');
		const formEdit = document.getElementById('formEditCiItem');
		const editName = document.getElementById('edit_ci_name');
		const editCategory = document.getElementById('edit_ci_category');
		const editTenant = document.getElementById('edit_ci_tenant');
		const editStatus = document.getElementById('edit_ci_status');
		const editSerial = document.getElementById('edit_ci_serial');
		const editIp = document.getElementById('edit_ci_ip');
		const editMac = document.getElementById('edit_ci_mac');
		const editLocation = document.getElementById('edit_ci_location');
		const editDesc = document.getElementById('edit_ci_description');

		if (modalEditEl && !modalEditEl.dataset.initialized) {
			modalEditEl.dataset.initialized = 'true';
			modalEditEl.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-edit-ci') || event.relatedTarget) : null;
				if (!btn) return;
				const row = btn.closest('.ci-row');

				const id = btn.dataset.ciId || (row ? row.dataset.id : '');
				const name = btn.dataset.ciName || (row ? row.dataset.name : '');
				const catId = btn.dataset.ciCategoryId || (row ? row.dataset.categoryId : '');
				const tenantId = btn.dataset.ciTenantId || (row ? row.dataset.tenantId : '');
				const status = btn.dataset.ciStatus || (row ? row.dataset.status : '');
				const serial = btn.dataset.ciSerial || (row ? row.dataset.serial : '');
				const ip = btn.dataset.ciIp || (row ? row.dataset.ip : '');
				const mac = btn.dataset.ciMac || (row ? row.dataset.mac : '');
				const location = btn.dataset.ciLocation || (row ? row.dataset.location : '');
				const desc = btn.dataset.ciDescription || (row ? row.dataset.description : '');

				if (formEdit) formEdit.action = `/cmdb/assets/${id}/edit`;
				if (editName) editName.value = name || '';
				if (editCategory) editCategory.value = catId || '';
				if (editTenant) editTenant.value = tenantId || '';
				if (editStatus) editStatus.value = status || 'Activo';
				if (editSerial) editSerial.value = serial || '';
				if (editIp) editIp.value = ip || '';
				if (editMac) editMac.value = mac || '';
				if (editLocation) editLocation.value = location || '';
				if (editDesc) editDesc.value = desc || '';
			});
		}

		// Modal Eliminar Activo (#modalDeleteCiItem)
		const modalDeleteEl = document.getElementById('modalDeleteCiItem');
		const formDelete = document.getElementById('formDeleteCiItem');
		const deleteDisplayName = document.getElementById('delete_ci_display_name');

		if (modalDeleteEl && !modalDeleteEl.dataset.initialized) {
			modalDeleteEl.dataset.initialized = 'true';
			modalDeleteEl.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-delete-ci') || event.relatedTarget) : null;
				if (!btn) return;
				const row = btn.closest('.ci-row');

				const id = btn.dataset.ciId || (row ? row.dataset.id : '');
				const name = btn.dataset.ciName || (row ? row.dataset.name : 'este activo');

				if (formDelete) formDelete.action = `/cmdb/assets/${id}/delete`;
				if (deleteDisplayName) deleteDisplayName.textContent = name;
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCiModalsAndFilters);
	} else {
		initCiModalsAndFilters();
	}
	document.addEventListener('turbo:load', initCiModalsAndFilters);
})();
</script>
{% endblock %}
