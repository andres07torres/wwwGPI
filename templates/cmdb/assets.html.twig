						<div class="col-md-4">
							<label for="edit_ci_serial" class="form-label small fw-semibold text-secondary">Número de Serie / Licencia</label>
							<input type="text" class="form-control" id="edit_ci_serial" name="serial_number" placeholder="SN-987654321">
						</div>
					</div>

					<div class="mb-3">
						<label for="edit_ci_location" class="form-label small fw-semibold text-secondary">Ubicación Física o Lógica</label>
						<input type="text" class="form-control" id="edit_ci_location" name="location" placeholder="ej. Rack A, U12 / Nube AWS">
					</div>

					<div class="mb-2">
						<label for="edit_ci_description" class="form-label small fw-semibold text-secondary">Descripción y Observaciones</label>
						<textarea class="form-control" id="edit_ci_description" name="description" rows="3"></textarea>
					</div>
				</div>

				<div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-center gap-3">
					<button type="submit" class="btn btn-panel-action px-4">Guardar</button>
					<button type="button" class="btn btn-outline-secondary px-4 btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>

