</div>
{% endblock %}

{% block page_scripts %}
<script>
(function() {
	const rawNodes = {{ graphNodesJson|raw }};
	const rawEdges = {{ graphEdgesJson|raw }};

	function initTopologyApp() {
		const canvas = document.getElementById('topologyCanvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		const container = document.getElementById('topologyCanvasContainer');
		const detailsDrawer = document.getElementById('nodeDetailsDrawer');
		const detailsContent = document.getElementById('nodeDetailsContent');
		const btnCloseDetails = document.getElementById('btnCloseDetails');
		const searchInput = document.getElementById('topologySearchInput');
		const typeFilter = document.getElementById('topologyTypeFilter');
		const btnZoomIn = document.getElementById('btnZoomIn');
		const btnZoomOut = document.getElementById('btnZoomOut');
		const btnFitGraph = document.getElementById('btnFitGraph');

		let width = container.clientWidth;
		let height = container.clientHeight;
		canvas.width = width;
		canvas.height = height;

		// Estado de cámara (pan & zoom)
		let zoom = 1;
		let panX = width / 2;
		let panY = height / 2;
		let isDragging = false;
		let dragStartX = 0;
		let dragStartY = 0;
		let draggedNode = null;
		let selectedNode = null;
		let hoveredNode = null;

		// Estructura de nodos con posición física
		const nodeRadius = 24;
		const nodes = rawNodes.map((n, i) => {
			const angle = (i / Math.max(rawNodes.length, 1)) * 2 * Math.PI;
			const radius = Math.min(width, height) * 0.38;
			return {
				...n,
				x: Math.cos(angle) * radius,
				y: Math.sin(angle) * radius,
				vx: 0,
				vy: 0,
			};
		});

		const nodeMap = {};
		nodes.forEach(n => { nodeMap[n.id] = n; });

		// Aristas válidas
		let edges = rawEdges.filter(e => nodeMap[e.from] && nodeMap[e.to]);

		function applyFilters() {
			const filterType = typeFilter ? typeFilter.value : '';
			edges = rawEdges.filter(e => {
				const matchesType = !filterType || e.type === filterType;
				return matchesType && nodeMap[e.from] && nodeMap[e.to];
			});
			render();
		}

		if (typeFilter) {
			typeFilter.addEventListener('change', applyFilters);
		}

		// Simulación de resortes para ordenamiento orgánico
		function simulateStep() {
			const repulsion = 10000;
			const springLength = 180;
			const springK = 0.035;
			const damping = 0.82;
			const minNodeDistance = 120; // Previene colisión o sobreposición de nodos y etiquetas

			// Repulsión entre nodos
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const dx = nodes[i].x - nodes[j].x;
					const dy = nodes[i].y - nodes[j].y;
					const dist = Math.sqrt(dx * dx + dy * dy) || 1;
					if (dist < 600) {
						let force = repulsion / (dist * dist);
						if (dist < minNodeDistance) {
							force += (minNodeDistance - dist) * 0.25;
						}
						const fx = (dx / dist) * force;
						const fy = (dy / dist) * force;
						nodes[i].vx += fx;
						nodes[i].vy += fy;
						nodes[j].vx -= fx;
						nodes[j].vy -= fy;
					}
				}
			}

			// Atracción de aristas
			edges.forEach(e => {
				const src = nodeMap[e.from];
				const dst = nodeMap[e.to];
				if (!src || !dst) return;
				const dx = dst.x - src.x;
				const dy = dst.y - src.y;
				const dist = Math.sqrt(dx * dx + dy * dy) || 1;
				const force = (dist - springLength) * springK;
				const fx = (dx / dist) * force;
				const fy = (dy / dist) * force;
				src.vx += fx;
				src.vy += fy;
				dst.vx -= fx;
				dst.vy -= fy;
			});

			// Actualizar posiciones
			nodes.forEach(n => {
				if (n !== draggedNode) {
					n.x += n.vx;
					n.y += n.vy;
					n.vx *= damping;
					n.vy *= damping;
				}
			});
		}

		let simSteps = 0;
		function runSimulation() {
			if (simSteps < 160) {
				simulateStep();
				simSteps++;
				render();
				if (simSteps === 2) {
					const canvasSkeleton = document.getElementById('topologyCanvasSkeleton');
					if (canvasSkeleton) {
						canvasSkeleton.style.opacity = '0';
						setTimeout(() => { if (canvasSkeleton && canvasSkeleton.parentNode) canvasSkeleton.remove(); }, 300);
					}
				}
				requestAnimationFrame(runSimulation);
			}
		}
		runSimulation();

		function render() {
			ctx.clearRect(0, 0, width, height);

			ctx.save();
			ctx.translate(panX, panY);
			ctx.scale(zoom, zoom);

			// 1. Dibujar aristas con flechas
			edges.forEach(e => {
				const src = nodeMap[e.from];
				const dst = nodeMap[e.to];
				if (!src || !dst) return;

				const isConnected = selectedNode && (selectedNode.id === src.id || selectedNode.id === dst.id);

				ctx.beginPath();
				ctx.moveTo(src.x, src.y);
				ctx.lineTo(dst.x, dst.y);

				if (e.type === 'depends_on') {
					ctx.strokeStyle = isConnected ? '#4f46e5' : '#a5b4fc';
					ctx.lineWidth = isConnected ? 2.5 : 1.5;
					ctx.setLineDash([]);
				} else if (e.type === 'hosted_on') {
					ctx.strokeStyle = isConnected ? '#0284c7' : '#7dd3fc';
					ctx.lineWidth = isConnected ? 2.5 : 1.5;
					ctx.setLineDash([4, 3]);
				} else {
					ctx.strokeStyle = isConnected ? '#475569' : '#cbd5e1';
					ctx.lineWidth = isConnected ? 2 : 1.2;
					ctx.setLineDash([2, 2]);
				}
				ctx.stroke();
				ctx.setLineDash([]);

				// Flecha direccional
				const angle = Math.atan2(dst.y - src.y, dst.x - src.x);
				const arrowDist = 26;
				const ax = dst.x - Math.cos(angle) * arrowDist;
				const ay = dst.y - Math.sin(angle) * arrowDist;

				ctx.beginPath();
				ctx.moveTo(ax, ay);
				ctx.lineTo(ax - 9 * Math.cos(angle - Math.PI / 6), ay - 9 * Math.sin(angle - Math.PI / 6));
				ctx.lineTo(ax - 9 * Math.cos(angle + Math.PI / 6), ay - 9 * Math.sin(angle + Math.PI / 6));
				ctx.closePath();
				ctx.fillStyle = ctx.strokeStyle;
				ctx.fill();

				// Etiqueta en el centro de la arista
				const mx = (src.x + dst.x) / 2;
				const my = (src.y + dst.y) / 2;
				ctx.font = '9px "Plus Jakarta Sans", sans-serif';
				ctx.fillStyle = '#64748b';
				ctx.textAlign = 'center';
				ctx.fillText(e.label, mx, my - 4);
			});

			// 2. Dibujar nodos
			const searchTerm = (searchInput ? searchInput.value : '').toLowerCase().trim();

			nodes.forEach(n => {
				const isSelected = selectedNode && selectedNode.id === n.id;
				const isHovered = hoveredNode && hoveredNode.id === n.id;
				const isMatched = searchTerm && n.label.toLowerCase().includes(searchTerm);

				// Sombra suave o brillo
				if (isSelected || isMatched) {
					ctx.beginPath();
					ctx.arc(n.x, n.y, nodeRadius + 5, 0, 2 * Math.PI);
					ctx.fillStyle = 'rgba(79, 70, 229, 0.25)';
					ctx.fill();
				}

				// Círculo base del nodo
				ctx.beginPath();
				ctx.arc(n.x, n.y, nodeRadius, 0, 2 * Math.PI);
				ctx.fillStyle = '#FFFFFF';
				ctx.fill();

				// Borde según estado operativo
				let borderColor = '#10b981'; // Activo
				if (n.status === 'Mantenimiento') borderColor = '#f59e0b';
				if (n.status === 'Dado de Baja') borderColor = '#94a3b8';

				ctx.lineWidth = isSelected ? 3.5 : 2;
				ctx.strokeStyle = isSelected ? '#14212B' : borderColor;
				ctx.stroke();

				// Letra central (Físico vs Lógico) sin emojis
				ctx.font = 'bold 12px "Plus Jakarta Sans", sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.fillStyle = '#14212B';
				ctx.fillText(n.type === 'Físico' ? 'F' : 'L', n.x, n.y);

				// Nombre del activo
				ctx.font = `${isSelected ? 'bold 12px' : '600 11px'} "Plus Jakarta Sans", sans-serif`;
				ctx.fillStyle = isSelected ? '#14212B' : '#334155';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'top';
				ctx.fillText(n.label, n.x, n.y + nodeRadius + 5);

				// IP o Categoría
				ctx.font = '10px "Plus Jakarta Sans", sans-serif';
				ctx.fillStyle = '#94a3b8';
				ctx.fillText(n.ip || n.category, n.x, n.y + nodeRadius + 20);
			});

			ctx.restore();
		}

		// Coordenadas mundiales desde pantalla
		function screenToWorld(sx, sy) {
			return {
				x: (sx - panX) / zoom,
				y: (sy - panY) / zoom,
			};
		}

		function findNodeAt(sx, sy) {
			const w = screenToWorld(sx, sy);
			for (let i = nodes.length - 1; i >= 0; i--) {
				const n = nodes[i];
				const dx = n.x - w.x;
				const dy = n.y - w.y;
				if (Math.sqrt(dx * dx + dy * dy) <= nodeRadius + 4) {
					return n;
				}
			}
			return null;
		}

		// Eventos de ratón para interactividad
		canvas.addEventListener('mousedown', e => {
			const rect = canvas.getBoundingClientRect();
			const sx = e.clientX - rect.left;
			const sy = e.clientY - rect.top;
			const hit = findNodeAt(sx, sy);

			if (hit) {
				draggedNode = hit;
				selectedNode = hit;
				showNodeDetails(hit);
			} else {
				isDragging = true;
				dragStartX = sx - panX;
				dragStartY = sy - panY;
			}
			render();
		});

		window.addEventListener('mousemove', e => {
			const rect = canvas.getBoundingClientRect();
			const sx = e.clientX - rect.left;
			const sy = e.clientY - rect.top;

			if (draggedNode) {
				const w = screenToWorld(sx, sy);
				draggedNode.x = w.x;
				draggedNode.y = w.y;
				render();
				return;
			}

			if (isDragging) {
				panX = sx - dragStartX;
				panY = sy - dragStartY;
				render();
				return;
			}

			const hit = findNodeAt(sx, sy);
			if (hit !== hoveredNode) {
				hoveredNode = hit;
				canvas.style.cursor = hit ? 'pointer' : 'grab';
				render();
			}
		});

		window.addEventListener('mouseup', () => {
			draggedNode = null;
			isDragging = false;
		});

		// Zoom con rueda de ratón
		canvas.addEventListener('wheel', e => {
			e.preventDefault();
			const rect = canvas.getBoundingClientRect();
			const sx = e.clientX - rect.left;
			const sy = e.clientY - rect.top;
			const wBefore = screenToWorld(sx, sy);

			const factor = e.deltaY < 0 ? 1.12 : 0.88;
			zoom = Math.min(Math.max(zoom * factor, 0.35), 2.8);

			panX = sx - wBefore.x * zoom;
			panY = sy - wBefore.y * zoom;
			render();
		}, { passive: false });

		// Botones de control de cámara
		if (btnZoomIn) {
			btnZoomIn.addEventListener('click', () => {
				zoom = Math.min(zoom * 1.2, 2.8);
				render();
			});
		}
		if (btnZoomOut) {
			btnZoomOut.addEventListener('click', () => {
				zoom = Math.max(zoom / 1.2, 0.35);
				render();
			});
		}
		if (btnFitGraph) {
			btnFitGraph.addEventListener('click', () => {
				panX = width / 2;
				panY = height / 2;
				zoom = 1;
				render();
			});
		}

		// Buscador de nodos
		if (searchInput) {
			searchInput.addEventListener('input', () => {
				const term = searchInput.value.toLowerCase().trim();
				if (term) {
					const found = nodes.find(n => n.label.toLowerCase().includes(term));
					if (found) {
						selectedNode = found;
						panX = width / 2 - found.x * zoom;
						panY = height / 2 - found.y * zoom;
						showNodeDetails(found);
					}
				}
				render();
			});
		}

		// Panel de detalle lateral
		function showNodeDetails(node) {
			if (!detailsDrawer || !detailsContent) return;

			// Dependencias entrantes y salientes
			const incoming = edges.filter(e => e.to === node.id).map(e => ({
				asset: nodeMap[e.from],
				label: e.label,
				type: e.type,
			}));

			const outgoing = edges.filter(e => e.from === node.id).map(e => ({
				asset: nodeMap[e.to],
				label: e.label,
				type: e.type,
			}));

			let incomingHtml = '';
			if (incoming.length > 0) {
				incomingHtml = incoming.map(r => `
					<div class="p-2 mb-1 rounded bg-light border small d-flex align-items-center justify-content-between gap-2">
						<div class="min-w-0 flex-grow-1">
							<div class="fw-semibold text-dark text-truncate">${r.asset.label}</div>
							<div class="text-muted" style="font-size: 10px;">${r.label}</div>
						</div>
						<span class="badge bg-secondary-subtle text-secondary flex-shrink-0" style="font-size: 10px;">Origen</span>
					</div>
				`).join('');
			} else {
				incomingHtml = '<div class="small text-muted fst-italic">Sin dependencias entrantes</div>';
			}

			let outgoingHtml = '';
			if (outgoing.length > 0) {
				outgoingHtml = outgoing.map(r => `
					<div class="p-2 mb-1 rounded bg-light border small d-flex align-items-center justify-content-between gap-2">
						<div class="min-w-0 flex-grow-1">
							<div class="fw-semibold text-dark text-truncate">${r.asset.label}</div>
							<div class="text-muted" style="font-size: 10px;">${r.label}</div>
						</div>
						<span class="badge bg-primary-subtle text-primary flex-shrink-0" style="font-size: 10px;">Destino</span>
					</div>
				`).join('');
			} else {
				outgoingHtml = '<div class="small text-muted fst-italic">Sin dependencias salientes</div>';
			}

			detailsContent.innerHTML = `
				<div class="mb-3">
					<div class="h5 fw-bold text-dark mb-1">${node.label}</div>
					<div class="badge bg-light text-dark border">${node.type} · ${node.category}</div>
				</div>
				<div class="small text-muted mb-3">${node.description || 'Sin descripción técnica registrada.'}</div>
				
				<div class="mb-3 small">
					<div class="d-flex justify-content-between align-items-center gap-3 py-2 border-bottom">
						<span class="text-secondary flex-shrink-0" style="min-width: 95px;">Estado:</span>
						<span class="fw-semibold text-end" style="color: var(--panel, #14212B);">${node.status}</span>
					</div>
					<div class="d-flex justify-content-between align-items-center gap-3 py-2 border-bottom">
						<span class="text-secondary flex-shrink-0" style="min-width: 95px;">Dirección IP:</span>
						<span class="font-monospace text-dark text-end">${node.ip || 'No asignada'}</span>
					</div>
					<div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">
						<span class="text-secondary flex-shrink-0" style="min-width: 95px;">Ubicación:</span>
						<span class="text-dark text-end flex-grow-1">${node.location || 'No especificada'}</span>
					</div>
					<div class="d-flex justify-content-between align-items-center gap-3 py-2 border-bottom">
						<span class="text-secondary flex-shrink-0" style="min-width: 95px;">Tenant:</span>
						<span class="text-dark text-end">${node.tenant}</span>
					</div>
				</div>

				<div class="mb-3">
					<div class="small fw-bold text-uppercase text-secondary mb-2" style="font-size: 11px;">Recursos que lo alimentan (In)</div>
					${incomingHtml}
				</div>

				<div class="mb-3">
					<div class="small fw-bold text-uppercase text-secondary mb-2" style="font-size: 11px;">Servicios dependientes (Out)</div>
					${outgoingHtml}
				</div>
			`;

			detailsDrawer.classList.remove('d-none');
			detailsDrawer.classList.add('d-flex');
		}

		if (btnCloseDetails) {
			btnCloseDetails.addEventListener('click', () => {
				detailsDrawer.classList.add('d-none');
				detailsDrawer.classList.remove('d-flex');
				selectedNode = null;
				render();
			});
		}

		// Responsive resize
		window.addEventListener('resize', () => {
			width = container.clientWidth;
			height = container.clientHeight;
			canvas.width = width;
			canvas.height = height;
			render();
		});

		// Modal Eliminar Relación
		const modalDeleteRel = document.getElementById('modalDeleteRelationship');
		const formDeleteRel = document.getElementById('formDeleteRelationship');
		const deleteDesc = document.getElementById('delete_rel_display_name');

		if (modalDeleteRel && !modalDeleteRel.dataset.initialized) {
			modalDeleteRel.dataset.initialized = 'true';
			modalDeleteRel.addEventListener('show.bs.modal', function(event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-delete-rel') || event.relatedTarget) : null;
				if (!btn) return;
				const id = btn.dataset.relId;
				const desc = btn.dataset.relDesc || 'esta relación';

				if (formDeleteRel) formDeleteRel.action = `/cmdb/topology/relationship/${id}/delete`;
				if (deleteDesc) deleteDesc.textContent = desc;
			});
		}

		// Paginación de Relaciones (5 por página para mantener la vista compacta bajo el mapa)
		const relRows = Array.from(document.querySelectorAll('.rel-row'));
		const relPageSize = 5;
		let currentRelPage = 1;

		function renderRelPagination() {
			const total = relRows.length;
			const totalPages = Math.max(1, Math.ceil(total / relPageSize));
			if (currentRelPage > totalPages) currentRelPage = totalPages;
			if (currentRelPage < 1) currentRelPage = 1;

			const startIndex = (currentRelPage - 1) * relPageSize;
			const endIndex = Math.min(startIndex + relPageSize, total);

			relRows.forEach(r => r.style.display = 'none');
			for (let i = startIndex; i < endIndex; i++) {
				if (relRows[i]) relRows[i].style.display = '';
			}

			const startEl = document.getElementById('relPageStart');
			const endEl = document.getElementById('relPageEnd');
			const totalEl = document.getElementById('relPageTotal');
			const navEl = document.getElementById('relPaginationNav');

			if (startEl) startEl.textContent = total === 0 ? '0' : (startIndex + 1);
			if (endEl) endEl.textContent = endIndex;
			if (totalEl) totalEl.textContent = total;

			if (navEl) {
				navEl.innerHTML = '';
				if (total <= relPageSize && totalPages <= 1) {
					const singleLi = document.createElement('li');
					singleLi.className = 'page-item active';
					singleLi.innerHTML = `<button type="button" class="page-link">1</button>`;
					navEl.appendChild(singleLi);
					return;
				}

				// Botón Anterior
				const prevLi = document.createElement('li');
				prevLi.className = `page-item ${currentRelPage === 1 ? 'disabled' : ''}`;
				prevLi.innerHTML = `<button type="button" class="page-link" aria-label="Anterior">&laquo; Anterior</button>`;
				prevLi.addEventListener('click', (e) => {
					e.preventDefault();
					if (currentRelPage > 1) {
						currentRelPage--;
						renderRelPagination();
					}
				});
				navEl.appendChild(prevLi);

				// Botones de página
				for (let p = 1; p <= totalPages; p++) {
					const pageLi = document.createElement('li');
					pageLi.className = `page-item ${p === currentRelPage ? 'active' : ''}`;
					pageLi.innerHTML = `<button type="button" class="page-link">${p}</button>`;
					pageLi.addEventListener('click', (e) => {
						e.preventDefault();
						currentRelPage = p;
						renderRelPagination();
					});
					navEl.appendChild(pageLi);
				}

				// Botón Siguiente
				const nextLi = document.createElement('li');
				nextLi.className = `page-item ${currentRelPage === totalPages ? 'disabled' : ''}`;
				nextLi.innerHTML = `<button type="button" class="page-link" aria-label="Siguiente">Siguiente &raquo;</button>`;
				nextLi.addEventListener('click', (e) => {
					e.preventDefault();
					if (currentRelPage < totalPages) {
						currentRelPage++;
						renderRelPagination();
					}
				});
				navEl.appendChild(nextLi);
			}
		}

		if (relRows.length > 0) {
			renderRelPagination();
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initTopologyApp);
	} else {
		initTopologyApp();
	}
	document.addEventListener('turbo:load', initTopologyApp);
})();
</script>
{% endblock %}
