{% extends 'layout.html.twig' %}

{% block title %}GPI · Mapa de Topología{% endblock %}

{% block content %}
<div class="user-module-wrapper">
	<!-- Encabezado del Módulo con Breadcrumbs -->
	<div class="mb-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-2 small">
				<li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">Inicio</a></li>
				<li class="breadcrumb-item text-muted">Infraestructura & Activos</li>
				<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Mapa de Topología</li>
			</ol>
		</nav>
		<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
			<div class="pe-md-3">
				<h1 class="h3 fw-bold text-dark mb-1">Mapa de Topología</h1>
				<p class="text-muted mb-0">
					Visualiza las dependencias, conexiones e interacciones de infraestructura para el análisis de impacto operativo y continuidad de servicio.
				</p>
			</div>
			<div class="d-flex align-items-center justify-content-end gap-2 flex-shrink-0">
				<button type="button" class="btn btn-panel-action shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateRelationship">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="5" x2="12" y2="19"/>
						<line x1="5" y1="12" x2="19" y2="12"/>
					</svg>
					<span>Nueva Relación</span>
				</button>
			</div>
		</div>
	</div>

	<!-- Resumen Rápido de Indicadores (KPIs) -->
	<div class="row g-3 mb-4">
		<!-- KPI 1: Nodos de Infraestructura -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Total Nodos">Nodos CIs</span>
						<div class="kpi-card-value text-truncate">{{ totalItems }}</div>
					</div>
					<div class="kpi-icon-panel" title="Total de Nodos en Topología">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="6" height="6" rx="1"/>
							<rect x="16" y="2" width="6" height="6" rx="1"/>
							<rect x="9" y="16" width="6" height="6" rx="1"/>
							<path d="M5 8v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/>
							<line x1="12" y1="13" x2="12" y2="16"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 2: Conexiones Activas -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Conexiones Activas">Relaciones</span>
						<div class="kpi-card-value text-truncate">{{ totalRelationships }}</div>
					</div>
					<div class="kpi-icon-panel" title="Relaciones entre Activos">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="18" cy="5" r="3"/>
							<circle cx="6" cy="12" r="3"/>
							<circle cx="18" cy="19" r="3"/>
							<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
							<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 3: Dependencias Críticas -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Dependencias Críticas">Dependencias</span>
						<div class="kpi-card-value text-truncate">{{ criticalDependencies }}</div>
					</div>
					<div class="kpi-icon-panel" title="Dependencias Directas de Servicio">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 2 7 12 12 22 7 12 2"/>
							<polyline points="2 17 12 22 22 17"/>
							<polyline points="2 12 12 17 22 12"/>
						</svg>
					</div>
				</div>
			</div>
		</div>

		<!-- KPI 4: Nodos en Mantenimiento -->
		<div class="col-6 col-md-3">
			<div class="card kpi-card border-0 shadow-sm rounded-3 h-100 bg-white">
				<div class="kpi-card-grid">
					<div class="min-w-0">
						<span class="kpi-card-label text-truncate" title="Nodos en Mantenimiento">Mantenimiento</span>
						<div class="kpi-card-value text-truncate">{{ maintenanceNodes }}</div>
					</div>
					<div class="kpi-icon-panel" title="Nodos en Mantenimiento">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
						</svg>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Tarjeta Principal: Visor Interactivo de Topología -->
	<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
		<!-- Barra de herramientas del grafo -->
		<div class="card-header bg-white border-bottom p-3">
			<div class="row g-2 align-items-center">
				<div class="col-12 col-md-4">
					<div class="position-relative">
						<input type="text" id="topologySearchInput" class="form-control form-control-sm ps-4" placeholder="Buscar nodo en el grafo...">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="position-absolute start-0 top-50 translate-middle-y ms-2 text-muted">
							<circle cx="11" cy="11" r="8"/>
							<line x1="21" y1="21" x2="16.65" y2="16.65"/>
						</svg>
					</div>
				</div>
				<div class="col-6 col-md-3">
					<form method="get" action="{{ path('app_cmdb_topology_index') }}" id="formTenantFilter">
						<select name="tenant" class="form-select form-select-sm" onchange="this.form.submit()">
							<option value="">Todas las organizaciones</option>
							{% for t in tenants %}
								<option value="{{ t.id.toRfc4122 }}" {{ selectedTenantId == t.id.toRfc4122 ? 'selected' : '' }}>
									{{ t.name }}
								</option>
							{% endfor %}
						</select>
					</form>
				</div>
				<div class="col-6 col-md-3">
					<select id="topologyTypeFilter" class="form-select form-select-sm">
						<option value="">Todas las relaciones</option>
						<option value="depends_on">Solo dependencias (depends_on)</option>
						<option value="hosted_on">Solo alojamiento (hosted_on)</option>
						<option value="connected_to">Solo conexiones (connected_to)</option>
					</select>
				</div>
				<div class="col-12 col-md-2 d-flex justify-content-end gap-1">
					<button type="button" class="btn btn-sm btn-outline-secondary" id="btnZoomIn" title="Acercar">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
					</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" id="btnZoomOut" title="Alejar">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
					</button>
					<button type="button" class="btn btn-sm btn-outline-secondary" id="btnFitGraph" title="Centrar grafo">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
					</button>
				</div>
			</div>
		</div>

		<!-- Área Visual del Grafo y Panel de Inspección Lateral -->
		<div class="position-relative bg-light" style="min-height: 520px; height: 560px; overflow: hidden;" id="topologyCanvasContainer">
			<!-- Skeleton Loader para el lienzo de topología -->
			<div id="topologyCanvasSkeleton" class="position-absolute top-0 start-0 w-100 h-100 bg-light d-flex flex-column align-items-center justify-content-center placeholder-glow" style="z-index: 12; transition: opacity 0.3s ease;">
				<div class="d-flex align-items-center justify-content-center gap-5 w-75 h-50">
					<div class="placeholder rounded-circle" style="width: 54px; height: 54px;"></div>
					<div class="placeholder rounded-circle" style="width: 72px; height: 72px;"></div>
					<div class="placeholder rounded-circle" style="width: 54px; height: 54px;"></div>
				</div>
				<div class="small text-muted mt-2 fw-semibold">Cargando topología de infraestructura...</div>
			</div>

			<!-- Canvas interactivo de dibujo del grafo -->
			<canvas id="topologyCanvas" class="w-100 h-100" style="cursor: grab; display: block;"></canvas>

			<!-- Leyenda visual flotante en la esquina inferior izquierda -->
			<div class="position-absolute bottom-0 start-0 m-3 p-2 bg-white rounded-3 shadow-sm border small" style="opacity: 0.95; pointer-events: none; max-width: 280px; z-index: 10;">
				<div class="fw-bold mb-1 text-dark" style="font-size: 11px;">Referencias de Topología</div>
				<div class="d-flex align-items-center gap-3 mb-1" style="font-size: 11px;">
					<span class="fw-semibold" style="color: var(--panel, #14212B);">Físico [F]</span>
					<span class="fw-semibold" style="color: var(--panel, #14212B);">Lógico [L]</span>
				</div>
				<div class="d-flex align-items-center gap-2" style="font-size: 10px;">
					<span style="color: #4f46e5;">━━</span> <span class="text-muted">Dependencia</span>
					<span style="color: #0284c7;">╍╍</span> <span class="text-muted">Alojado en</span>
					<span style="color: #64748b;">┈┈</span> <span class="text-muted">Conexión</span>
				</div>
			</div>

			<!-- Panel de Inspección lateral derecho (al seleccionar un nodo) -->
			<div id="nodeDetailsDrawer" class="position-absolute top-0 end-0 h-100 bg-white border-start shadow-sm p-3 d-none flex-column" style="width: 360px; max-width: 92vw; z-index: 20; overflow-y: auto;">
				<div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
					<h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--panel);"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/></svg>
						<span>Detalle del Nodo</span>
					</h6>
					<button type="button" class="btn-close btn-sm" id="btnCloseDetails" aria-label="Cerrar"></button>
				</div>
				<div id="nodeDetailsContent">
					<!-- Se rellena dinámicamente con JavaScript -->
				</div>
			</div>

			<!-- Mensaje si no hay activos registrados -->
			{% if items is empty %}
				<div class="position-absolute top-50 start-50 translate-middle text-center p-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted mb-2">
						<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
						<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
					</svg>
					<h6 class="fw-bold text-dark">No hay activos registrados para graficar</h6>
					<p class="text-muted small mb-3">Registra activos en el inventario para comenzar a trazar el mapa de topología.</p>
					<a href="{{ path('app_cmdb_asset_index') }}" class="btn btn-sm btn-panel-action">Ir al Inventario</a>
				</div>
			{% endif %}
		</div>
	</div>

	<!-- Tarjeta Inferior: Tabla de Relaciones Registradas -->
	<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
		<div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between">
			<div class="fw-bold text-dark d-flex align-items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
				<span>Matriz de Relaciones Activas ({{ relationships|length }})</span>
			</div>
			<button type="button" class="btn btn-sm btn-outline-panel" data-bs-toggle="modal" data-bs-target="#modalCreateRelationship">
				+ Conectar Activos
			</button>
		</div>

		<div class="table-responsive">
			<table class="table align-middle table-hover mb-0" id="relationshipsTable">
				<thead class="table-light">
					<tr>
						<th class="ps-3 py-3 text-secondary text-uppercase small fw-bold" style="width: 32%;">Activo Origen (Padre / Recurso)</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold text-center" style="width: 22%;">Tipo de Conexión</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 32%;">Activo Destino (Hijo / Dependiente)</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold text-end pe-3" style="width: 14%;">Acción</th>
					</tr>
				</thead>
				<tbody>
					{% for rel in relationships %}
						<tr class="rel-row" data-type="{{ rel.relationshipType.value }}">
							<td class="ps-3 py-3">
								<div class="fw-bold text-dark">{{ rel.parentCi.name }}</div>
								<div class="small text-muted">{{ rel.parentCi.category ? rel.parentCi.category.name : 'Sin categoría' }} · {{ rel.parentCi.ipAddress|default('Sin IP') }}</div>
							</td>
							<td class="py-3 text-center">
								{% if rel.relationshipType.value == 'depends_on' %}
									<span class="small fw-semibold text-primary">Depende de</span>
								{% elseif rel.relationshipType.value == 'hosted_on' %}
									<span class="small fw-semibold text-info-emphasis">Alojado en</span>
								{% else %}
									<span class="small fw-semibold text-secondary">Conectado a</span>
								{% endif %}
							</td>
							<td class="py-3">
								<div class="fw-bold text-dark">{{ rel.childCi.name }}</div>
								<div class="small text-muted">{{ rel.childCi.category ? rel.childCi.category.name : 'Sin categoría' }} · {{ rel.childCi.ipAddress|default('Sin IP') }}</div>
							</td>
							<td class="py-3 text-end pe-3">
								<button type="button" 
									class="btn btn-sm btn-outline-danger btn-icon-action btn-delete-rel" 
									title="Eliminar relación" 
									aria-label="Eliminar relación"
									data-bs-toggle="modal" 
									data-bs-target="#modalDeleteRelationship"
									data-rel-id="{{ rel.id }}"
									data-rel-desc="{{ rel.parentCi.name }} ({{ rel.relationshipType.value }}) {{ rel.childCi.name }}">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="3 6 5 6 21 6"/>
										<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
										<line x1="10" y1="11" x2="10" y2="17"/>
										<line x1="14" y1="11" x2="14" y2="17"/>
									</svg>
								</button>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="text-center py-5 text-muted">
								<div class="d-flex flex-column align-items-center justify-content-center">
									<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 opacity-50">
										<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
										<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
									</svg>
									<div class="fw-semibold text-dark">No hay relaciones registradas en la topología</div>
									<div class="small text-muted mt-1">Haz clic en "Nueva Relación" para conectar dos elementos de configuración.</div>
								</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<!-- Paginación de Relaciones -->
		<div class="card-footer bg-white border-top p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" id="relPaginationFooter">
			<div class="small text-secondary" id="relPaginationInfo">
				Mostrando <span class="fw-bold text-dark" id="relPageStart">0</span> a <span class="fw-bold text-dark" id="relPageEnd">0</span> de <span class="fw-bold text-dark" id="relPageTotal">0</span> registros
			</div>
			<nav aria-label="Navegación de relaciones">
				<ul class="pagination pagination-sm mb-0 gap-1" id="relPaginationNav"></ul>
			</nav>
		</div>
	</div>
</div>

{# =====================================================================
   MODAL: CREAR RELACIÓN DE TOPOLOGÍA
   ===================================================================== #}
<div class="modal fade" id="modalCreateRelationship" tabindex="-1" aria-labelledby="modalCreateRelationshipLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<form action="{{ path('app_cmdb_topology_rel_create') }}" method="post" id="formCreateRelationship">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('create_ci_relationship') }}">
				
				<div class="modal-header border-bottom">
					<h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2 min-w-0 me-2" id="modalCreateRelationshipLabel">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" style="color: var(--panel, #14212B);">
							<circle cx="18" cy="5" r="3"/>
							<circle cx="6" cy="12" r="3"/>
							<circle cx="18" cy="19" r="3"/>
							<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
							<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
						</svg>
						<span class="text-break">Conectar Activos en Topología</span>
					</h5>
					<button type="button" class="btn-close flex-shrink-0 mt-1" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>
				
				<div class="modal-body px-4 py-3">
					<div class="mb-3">
						<label for="rel_parent_ci" class="form-label small fw-semibold text-secondary">Activo Origen (Padre / Proveedor del recurso) <span class="text-danger">*</span></label>
						<select class="form-select" id="rel_parent_ci" name="parent_ci_id" required>
							<option value="">Selecciona el activo origen...</option>
							{% for it in items %}
								<option value="{{ it.id.toRfc4122 }}">{{ it.name }} ({{ it.category ? it.category.name : 'CI' }})</option>
							{% endfor %}
						</select>
					</div>

					<div class="mb-3">
						<label for="rel_type" class="form-label small fw-semibold text-secondary">Tipo de Relación <span class="text-danger">*</span></label>
						<select class="form-select" id="rel_type" name="relationship_type" required>
							<option value="depends_on">Depende de (depends_on) — Ej: El servicio web depende de la BD</option>
							<option value="hosted_on">Alojado en (hosted_on) — Ej: La VM reside en el Servidor Blade</option>
							<option value="connected_to">Conectado a (connected_to) — Ej: El servidor se conecta al Switch</option>
						</select>
					</div>

					<div class="mb-2">
						<label for="rel_child_ci" class="form-label small fw-semibold text-secondary">Activo Destino (Hijo / Dependiente) <span class="text-danger">*</span></label>
						<select class="form-select" id="rel_child_ci" name="child_ci_id" required>
							<option value="">Selecciona el activo destino...</option>
							{% for it in items %}
								<option value="{{ it.id.toRfc4122 }}">{{ it.name }} ({{ it.category ? it.category.name : 'CI' }})</option>
							{% endfor %}
						</select>
					</div>
				</div>

				<div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-center gap-3">
					<button type="submit" class="btn btn-panel-action px-4">Guardar</button>
					<button type="button" class="btn btn-outline-secondary px-4 btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>

{# =====================================================================
   MODAL: ELIMINAR RELACIÓN
   ===================================================================== #}
<div class="modal fade" id="modalDeleteRelationship" tabindex="-1" aria-labelledby="modalDeleteRelationshipLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-sm">
		<div class="modal-content border-0 shadow">
			<form action="" method="post" id="formDeleteRelationship">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_ci_relationship') }}">
				
				<div class="modal-body text-center p-4">
					<div class="avatar-circle-lg bg-danger-subtle text-danger mx-auto mb-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"/>
							<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
							<line x1="10" y1="11" x2="10" y2="17"/>
							<line x1="14" y1="11" x2="14" y2="17"/>
						</svg>
					</div>
					<h5 class="fw-bold text-dark mb-1">¿Desconectar relación?</h5>
					<p class="text-muted small mb-0">
						Estás a punto de desvincular <strong class="text-dark" id="delete_rel_display_name">--</strong>. La topología se actualizará inmediatamente.
					</p>
				</div>

				<div class="modal-footer border-0 px-3 pb-3 pt-0 justify-content-center gap-3">
					<button type="submit" class="btn btn-danger px-4 py-2 fw-semibold rounded-3">Guardar</button>
					<button type="button" class="btn btn-outline-secondary px-4 btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
