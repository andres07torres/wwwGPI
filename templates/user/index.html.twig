{% extends 'layout.html.twig' %}

{% block title %}GPI · Gestión de Usuarios{% endblock %}

{% block content %}
<div class="user-module-wrapper">
	<!-- Encabezado del Módulo con Título, Breve Descripción y Botón Agregar -->
	<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
		<div class="pe-md-3">
			<h1 class="h3 fw-bold text-dark mb-1">Gestión de Usuarios</h1>
			<p class="text-muted mb-0">
				Administra las cuentas de usuario de la plataforma, asigna roles de acceso, controla permisos y supervisa el estado de activación en cada organización.
			</p>
		</div>
		<div class="flex-shrink-0">
			<button type="button" class="btn btn-create-user shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateUser">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
					<circle cx="9" cy="7" r="4"/>
					<line x1="19" y1="8" x2="19" y2="14"/>
					<line x1="22" y1="11" x2="16" y2="11"/>
				</svg>
				<span>Nuevo Usuario</span>
			</button>
		</div>
	</div>

	<!-- Tarjeta con Buscador y Tabla de Usuarios -->
	<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
		<!-- Barra de herramientas: Búsqueda rápida y conteo -->
		<div class="card-header bg-white border-bottom p-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
			<div class="d-flex align-items-center gap-2">
				<span class="fw-bold text-dark">Todos los usuarios</span>
				<span class="badge bg-light text-muted border rounded-pill">{{ users|length }} registrados</span>
			</div>
			<div class="position-relative" style="max-width: 320px; width: 100%;">
				<input type="text" id="tableSearchInput" class="form-control form-control-sm ps-4" placeholder="Buscar por nombre, usuario o email...">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="position-absolute start-0 top-50 translate-middle-y ms-2 text-muted">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</div>
		</div>

		<!-- Tabla de Datos -->
		<div class="table-responsive">
			<table class="table align-middle table-hover mb-0" id="usersTable">
				<thead class="table-light">
					<tr>
						<th class="ps-3 py-3 text-secondary text-uppercase small fw-bold" style="width: 28%;">Usuario</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 20%;">Correo Electrónico</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 15%;">Rol de Acceso</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 13%;">Tenant</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold" style="width: 10%;">Estado</th>
						<th class="py-3 text-secondary text-uppercase small fw-bold text-end pe-3" style="width: 14%;">Acciones</th>
					</tr>
				</thead>
				<tbody>
					{% for u in users %}
						<tr class="user-row" 
							data-search="{{ u.name }} {{ u.username }} {{ u.email }}"
							data-id="{{ u.id.toRfc4122 }}"
							data-name="{{ u.name }}"
							data-username="{{ u.username }}"
							data-email="{{ u.email }}"
							data-status="{{ u.isStatus ? '1' : '0' }}"
							data-role-id="{{ u.role ? u.role.id : '' }}"
							data-role-name="{{ u.role ? u.role.name : 'Sin Rol Asignado' }}"
							data-tenant-id="{{ u.tenant ? u.tenant.id.toRfc4122 : '' }}"
						>
							<!-- Columna Usuario: Avatar + Nombre + Username -->
							<td class="ps-3 py-3">
								<div class="d-flex align-items-center gap-3">
									<div class="avatar-circle">
										{{ (u.name|default(u.username)|slice(0, 2))|upper }}
									</div>
									<div class="min-w-0">
										<div class="fw-bold text-dark text-truncate">{{ u.name }}</div>
										<div class="small text-muted text-truncate">@{{ u.username }}</div>
									</div>
								</div>
							</td>

							<!-- Columna Email -->
							<td class="py-3">
								<span class="small text-dark">{{ u.email }}</span>
							</td>

							<!-- Columna Rol -->
							<td class="py-3">
								{% if u.role %}
									{% set rName = u.role.name %}
									{% if 'SUPER' in rName|upper %}
										<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
											{{ rName }}
										</span>
									{% elseif 'ADMIN' in rName|upper %}
										<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
											{{ rName }}
										</span>
									{% elseif 'ESPECIALISTA' in rName|upper or 'TECNICO' in rName|upper %}
										<span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-pill">
											{{ rName }}
										</span>
									{% else %}
										<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
											{{ rName }}
										</span>
									{% endif %}
								{% else %}
									<span class="badge bg-light text-muted border px-2 py-1 rounded-pill">Sin Rol</span>
								{% endif %}
							</td>

							<!-- Columna Tenant -->
							<td class="py-3">
								<span class="badge bg-light text-dark border px-2 py-1 rounded">
									{{ u.tenant ? u.tenant.name : 'Default' }}
								</span>
							</td>

							<!-- Columna Estado -->
							<td class="py-3">
								{% if u.isStatus %}
									<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill d-inline-flex align-items-center gap-1">
										<span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
										Activo
									</span>
								{% else %}
									<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill d-inline-flex align-items-center gap-1">
										<span class="d-inline-block rounded-circle bg-secondary" style="width: 6px; height: 6px;"></span>
										Inactivo
									</span>
								{% endif %}
							</td>

							<!-- Columna de Acciones con los 3 Iconos: Editar, Roles/Permisos, Eliminar (habilitados como Modals) -->
							<td class="py-3 text-end pe-3">
								<div class="d-inline-flex align-items-center gap-1">
									<!-- 1. Botón Editar (Abre #modalEditUser) -->
									<button type="button" 
										class="btn btn-sm btn-outline-secondary btn-icon-action btn-edit-user" 
										title="Editar usuario" 
										aria-label="Editar usuario"
										data-bs-toggle="modal" 
										data-bs-target="#modalEditUser"
										data-user-id="{{ u.id.toRfc4122 }}"
										data-user-name="{{ u.name|e('html_attr') }}"
										data-user-username="{{ u.username|e('html_attr') }}"
										data-user-email="{{ u.email|e('html_attr') }}"
										data-user-status="{{ u.isStatus ? '1' : '0' }}">
										<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
										</svg>
									</button>

									<!-- 2. Botón Roles y Permisos (Abre #modalUserRoles) -->
									<button type="button" 
										class="btn btn-sm btn-outline-primary btn-icon-action btn-roles-user" 
										title="Gestionar roles y permisos" 
										aria-label="Gestionar roles y permisos"
										data-bs-toggle="modal" 
										data-bs-target="#modalUserRoles"
										data-user-id="{{ u.id.toRfc4122 }}"
										data-user-name="{{ u.name|e('html_attr') }}"
										data-user-username="{{ u.username|e('html_attr') }}"
										data-user-email="{{ u.email|e('html_attr') }}"
										data-user-role-id="{{ u.role ? u.role.id : '' }}">
										<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
											<circle cx="12" cy="11" r="3"/>
										</svg>
									</button>

									<!-- 3. Botón Eliminar (Abre #modalDeleteUser) -->
									<button type="button" 
										class="btn btn-sm btn-outline-danger btn-icon-action btn-delete-user" 
										title="Eliminar usuario" 
										aria-label="Eliminar usuario"
										data-bs-toggle="modal" 
										data-bs-target="#modalDeleteUser"
										data-user-id="{{ u.id.toRfc4122 }}"
										data-user-name="{{ u.name|e('html_attr') }}"
										data-user-username="{{ u.username|e('html_attr') }}"
										{{ app.user and app.user.id.toRfc4122 == u.id.toRfc4122 ? 'disabled title="No puedes eliminarte a ti mismo"' : '' }}>
										<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="3 6 5 6 21 6"/>
											<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
											<line x1="10" y1="11" x2="10" y2="17"/>
											<line x1="14" y1="11" x2="14" y2="17"/>
										</svg>
									</button>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center py-5 text-muted">
								<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 opacity-50"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
								<div>No se encontraron usuarios en este tenant.</div>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>

{# =====================================================================
   1. MODAL: AGREGAR NUEVO USUARIO
   ===================================================================== #}
<div class="modal fade" id="modalCreateUser" tabindex="-1" aria-labelledby="modalCreateUserLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<form action="{{ path('app_user_create') }}" method="post" id="formCreateUser">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('create_user') }}">
				
				<div class="modal-header border-bottom px-4 py-3">
					<h5 class="modal-title fw-bold text-dark" id="modalCreateUserLabel">Registrar Nuevo Usuario</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>
				
				<div class="modal-body px-4 py-3">
					<div class="mb-3">
						<label for="create_name" class="form-label small fw-semibold text-secondary">Nombre Completo <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="create_name" name="name" required placeholder="ej. Carlos Torres">
					</div>
					
					<div class="row g-2 mb-3">
						<div class="col-md-6">
							<label for="create_username" class="form-label small fw-semibold text-secondary">Usuario <span class="text-danger">*</span></label>
							<input type="text" class="form-control" id="create_username" name="username" required placeholder="ej. ctorres">
						</div>
						<div class="col-md-6">
							<label for="create_email" class="form-label small fw-semibold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
							<input type="email" class="form-control" id="create_email" name="email" required placeholder="correo@empresa.com">
						</div>
					</div>

					<div class="mb-3">
						<label for="create_password" class="form-label small fw-semibold text-secondary">Contraseña Temporal <span class="text-danger">*</span></label>
						<input type="password" class="form-control" id="create_password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres">
					</div>

					<div class="row g-2 mb-3">
						<div class="col-md-6">
							<label for="create_role" class="form-label small fw-semibold text-secondary">Rol Inicial</label>
							<select class="form-select" id="create_role" name="role_id">
								<option value="">Seleccionar rol...</option>
								{% for r in roles %}
									<option value="{{ r.id }}">{{ r.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-6">
							<label for="create_tenant" class="form-label small fw-semibold text-secondary">Tenant / Empresa</label>
							<select class="form-select" id="create_tenant" name="tenant_id">
								{% for t in tenants %}
									<option value="{{ t.id.toRfc4122 }}">{{ t.name }} ({{ t.domain }})</option>
								{% endfor %}
							</select>
						</div>
					</div>

					<div class="form-check form-switch mt-2">
						<input class="form-check-input" type="checkbox" role="switch" id="create_status" name="status" value="1" checked>
						<label class="form-check-label small fw-semibold text-dark" for="create_status">Usuario activo y habilitado para iniciar sesión</label>
					</div>
				</div>

				<div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-center gap-2">
					<button type="submit" class="btn btn-panel-action">Guardar</button>
					<button type="button" class="btn btn-outline-secondary btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>

{# =====================================================================
   2. MODAL: EDITAR USUARIO
   ===================================================================== #}
<div class="modal fade" id="modalEditUser" tabindex="-1" aria-labelledby="modalEditUserLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<form action="" method="post" id="formEditUser">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('edit_user') }}">
				
				<div class="modal-header border-bottom px-4 py-3">
					<h5 class="modal-title fw-bold text-dark" id="modalEditUserLabel">Editar Usuario</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>
				
				<div class="modal-body px-4 py-3">
					<div class="mb-3">
						<label for="edit_name" class="form-label small fw-semibold text-secondary">Nombre Completo <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="edit_name" name="name" required>
					</div>
					
					<div class="row g-2 mb-3">
						<div class="col-md-6">
							<label for="edit_username" class="form-label small fw-semibold text-secondary">Usuario <span class="text-danger">*</span></label>
							<input type="text" class="form-control" id="edit_username" name="username" required>
						</div>
						<div class="col-md-6">
							<label for="edit_email" class="form-label small fw-semibold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
							<input type="email" class="form-control" id="edit_email" name="email" required>
						</div>
					</div>

					<div class="mb-3">
						<label for="edit_password" class="form-label small fw-semibold text-secondary">Cambiar Contraseña (opcional)</label>
						<input type="password" class="form-control" id="edit_password" name="password" minlength="8" placeholder="Dejar en blanco para conservar la actual">
					</div>

					<div class="form-check form-switch mt-2">
						<input class="form-check-input" type="checkbox" role="switch" id="edit_status" name="status" value="1">
						<label class="form-check-label small fw-semibold text-dark" for="edit_status">Estado de la cuenta: Activo</label>
					</div>
				</div>

				<div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-center gap-2">
					<button type="submit" class="btn btn-panel-action">Guardar</button>
					<button type="button" class="btn btn-outline-secondary btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>

{# =====================================================================
   3. MODAL: GESTIONAR ROLES Y PERMISOS
   ===================================================================== #}
<div class="modal fade" id="modalUserRoles" tabindex="-1" aria-labelledby="modalUserRolesLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<form action="" method="post" id="formUserRoles">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('manage_roles') }}">
				
				<div class="modal-header border-bottom px-4 py-3">
					<h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="modalUserRolesLabel">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/></svg>
						<span>Roles y Permisos de Acceso</span>
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>
				
				<div class="modal-body px-4 py-3">
					<div class="p-3 bg-light rounded-3 mb-3 border">
						<div class="small text-muted">Usuario en gestión:</div>
						<div class="fw-bold fs-6 text-dark" id="roles_modal_user_name">--</div>
						<div class="small text-secondary" id="roles_modal_user_info">--</div>
					</div>

					<div class="mb-3">
						<label for="roles_select_role" class="form-label small fw-semibold text-secondary">Rol Asignado</label>
						<select class="form-select" id="roles_select_role" name="role_id">
							<option value="">Sin Rol (Acceso estándar básico)</option>
							{% for r in roles %}
								<option value="{{ r.id }}" data-perms="{{ r.permissions|map(p => p.code)|join(',') }}">
									{{ r.name }}
								</option>
							{% endfor %}
						</select>
					</div>

					<div class="mt-3">
						<div class="small fw-semibold text-secondary mb-2">Permisos asignados según el Rol seleccionado:</div>
						<div class="p-3 border rounded-3 bg-white" style="max-height: 200px; overflow-y: auto;" id="rolePermissionsContainer">
							{% for p in permissions %}
								<div class="form-check mb-2 perm-item" data-code="{{ p.code }}">
									<input class="form-check-input perm-checkbox" type="checkbox" id="perm_{{ p.id }}" value="{{ p.code }}" disabled>
									<label class="form-check-label small" for="perm_{{ p.id }}">
										<strong class="text-dark">{{ p.name }}</strong>
										<span class="text-muted d-block" style="font-size: 11px;">Código: {{ p.code }}</span>
									</label>
								</div>
							{% endfor %}
						</div>
					</div>
				</div>

				<div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-center gap-2">
					<button type="submit" class="btn btn-panel-action">Guardar</button>
					<button type="button" class="btn btn-outline-secondary btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>

{# =====================================================================
   4. MODAL: CONFIRMAR ELIMINACIÓN
   ===================================================================== #}
<div class="modal fade" id="modalDeleteUser" tabindex="-1" aria-labelledby="modalDeleteUserLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-sm">
		<div class="modal-content border-0 shadow">
			<form action="" method="post" id="formDeleteUser">
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_user') }}">
				
				<div class="modal-body text-center p-4">
					<div class="avatar-circle-lg bg-danger-subtle text-danger mx-auto mb-3">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"/>
							<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
						</svg>
					</div>
					<h5 class="fw-bold text-dark mb-1">¿Eliminar usuario?</h5>
					<p class="text-muted small mb-0">
						Estás a punto de eliminar a <strong class="text-dark" id="delete_user_display_name">--</strong>. Esta acción revocará todos sus accesos de manera inmediata.
					</p>
				</div>

				<div class="modal-footer border-0 px-3 pb-3 pt-0 justify-content-center gap-2">
					<button type="submit" class="btn btn-danger px-3 py-2 fw-semibold rounded-3">Sí, Eliminar</button>
					<button type="button" class="btn btn-outline-secondary btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
				</div>
			</form>
		</div>
	</div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
(function() {
	function initUserModals() {
		// 1. Buscador rápido en tiempo real
		const searchInput = document.getElementById('tableSearchInput');
		if (searchInput && !searchInput.dataset.initialized) {
			searchInput.dataset.initialized = 'true';
			searchInput.addEventListener('input', function () {
				const term = this.value.toLowerCase().trim();
				document.querySelectorAll('.user-row').forEach(row => {
					const searchData = (row.dataset.search || '').toLowerCase();
					row.style.display = searchData.includes(term) ? '' : 'none';
				});
			});
		}

		// 2. Modal Editar Usuario (#modalEditUser)
		const modalEditEl = document.getElementById('modalEditUser');
		const formEdit = document.getElementById('formEditUser');
		const editName = document.getElementById('edit_name');
		const editUsername = document.getElementById('edit_username');
		const editEmail = document.getElementById('edit_email');
		const editStatus = document.getElementById('edit_status');

		if (modalEditEl && !modalEditEl.dataset.initialized) {
			modalEditEl.dataset.initialized = 'true';
			modalEditEl.addEventListener('show.bs.modal', function (event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-edit-user') || event.relatedTarget) : null;
				if (!btn) return;
				const row = btn.closest('.user-row');

				const id = btn.dataset.userId || (row ? row.dataset.id : '');
				const name = btn.dataset.userName || (row ? row.dataset.name : '');
				const username = btn.dataset.userUsername || (row ? row.dataset.username : '');
				const email = btn.dataset.userEmail || (row ? row.dataset.email : '');
				const status = btn.dataset.userStatus !== undefined ? btn.dataset.userStatus : (row ? row.dataset.status : '1');

				if (formEdit) formEdit.action = `/users/${id}/edit`;
				if (editName) editName.value = name || '';
				if (editUsername) editUsername.value = username || '';
				if (editEmail) editEmail.value = email || '';
				if (editStatus) editStatus.checked = (status === '1');
			});
		}

		// 3. Modal Gestionar Roles y Permisos (#modalUserRoles)
		const modalRolesEl = document.getElementById('modalUserRoles');
		const formRoles = document.getElementById('formUserRoles');
		const rolesModalUserName = document.getElementById('roles_modal_user_name');
		const rolesModalUserInfo = document.getElementById('roles_modal_user_info');
		const rolesSelectRole = document.getElementById('roles_select_role');
		const permCheckboxes = document.querySelectorAll('.perm-checkbox');

		function updatePermissionsCheckboxes() {
			if (!rolesSelectRole) return;
			const selectedOpt = rolesSelectRole.options[rolesSelectRole.selectedIndex];
			const permsStr = selectedOpt ? (selectedOpt.dataset.perms || '') : '';
			const permsArr = permsStr ? permsStr.split(',') : [];

			permCheckboxes.forEach(cb => {
				const item = cb.closest('.perm-item');
				if (permsArr.includes(cb.value)) {
					cb.checked = true;
					if (item) item.classList.add('bg-primary-subtle', 'rounded', 'px-2');
				} else {
					cb.checked = false;
					if (item) item.classList.remove('bg-primary-subtle', 'rounded', 'px-2');
				}
			});
		}

		if (rolesSelectRole && !rolesSelectRole.dataset.initialized) {
			rolesSelectRole.dataset.initialized = 'true';
			rolesSelectRole.addEventListener('change', updatePermissionsCheckboxes);
		}

		if (modalRolesEl && !modalRolesEl.dataset.initialized) {
			modalRolesEl.dataset.initialized = 'true';
			modalRolesEl.addEventListener('show.bs.modal', function (event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-roles-user') || event.relatedTarget) : null;
				if (!btn) return;
				const row = btn.closest('.user-row');

				const id = btn.dataset.userId || (row ? row.dataset.id : '');
				const name = btn.dataset.userName || (row ? row.dataset.name : '');
				const username = btn.dataset.userUsername || (row ? row.dataset.username : '');
				const email = btn.dataset.userEmail || (row ? row.dataset.email : '');
				const roleId = btn.dataset.userRoleId || (row ? row.dataset.roleId : '');

				if (formRoles) formRoles.action = `/users/${id}/roles`;
				if (rolesModalUserName) rolesModalUserName.textContent = name || username;
				if (rolesModalUserInfo) rolesModalUserInfo.textContent = `@${username} · ${email}`;
				if (rolesSelectRole) rolesSelectRole.value = roleId || '';

				updatePermissionsCheckboxes();
			});
		}

		// 4. Modal Eliminar Usuario (#modalDeleteUser)
		const modalDeleteEl = document.getElementById('modalDeleteUser');
		const formDelete = document.getElementById('formDeleteUser');
		const deleteUserDisplayName = document.getElementById('delete_user_display_name');

		if (modalDeleteEl && !modalDeleteEl.dataset.initialized) {
			modalDeleteEl.dataset.initialized = 'true';
			modalDeleteEl.addEventListener('show.bs.modal', function (event) {
				const btn = event.relatedTarget ? (event.relatedTarget.closest('.btn-delete-user') || event.relatedTarget) : null;
				if (!btn) return;
				const row = btn.closest('.user-row');

				const id = btn.dataset.userId || (row ? row.dataset.id : '');
				const name = btn.dataset.userName || (row ? row.dataset.name : '');
				const username = btn.dataset.userUsername || (row ? row.dataset.username : '');

				if (formDelete) formDelete.action = `/users/${id}/delete`;
				if (deleteUserDisplayName) deleteUserDisplayName.textContent = `${name} (@${username})`;
			});
		}
	}

	// Inicializar en carga directa y en navegaciones con Turbo
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initUserModals);
	} else {
		initUserModals();
	}
	document.addEventListener('turbo:load', initUserModals);
})();
</script>
{% endblock %}
